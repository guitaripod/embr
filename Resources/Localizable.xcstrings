    "Web links open inside Embr, or in your browser when this is off.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links til websider åbnes i Embr, eller i din browser, når dette er slået fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weblinks öffnen sich in Embr oder, wenn diese Option deaktiviert ist, im Browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces web se abren en Embr o en tu navegador si esta opción está desactivada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkolinkit avautuvat Embrissä, tai jos tämä on pois päältä, selaimessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens web s’ouvrent dans Embr, ou dans votre navigateur si cette option est désactivée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vefhlekkir opnast í Embr eða í vafranum þegar þetta er slökkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link web si aprono in Embr, oppure nel browser se questa opzione è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブリンクは Embr 内で開き、この設定がオフのときはブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 링크는 Embr 안에서 열리며, 이 옵션을 끄면 브라우저에서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weblenker åpnes i Embr, eller i nettleseren når dette er av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki do stron otwierają się w Embr lub w przeglądarce, gdy ta opcja jest wyłączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links da web abrem dentro do Embr, ou no navegador quando esta opção está desativada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webblänkar öppnas i Embr, eller i webbläsaren när det här är avstängt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页链接会在 Embr 内打开；关闭此选项后则在浏览器中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁連結會在 Embr 內開啟；關閉此選項後則在瀏覽器中開啟。"
          }
        }
      }
    },
