    "No messages from them since you opened this chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit du diesen Chat geöffnet hast, gibt es keine Nachrichten von ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay mensajes de esta persona desde que abriste este chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message de cette personne depuis l'ouverture de ce chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun messaggio da parte loro da quando hai aperto questa chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを開いてから、この人の発言はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅을 연 후로 이 사용자의 메시지가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od otwarcia tego czatu nie ma od nich żadnych wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mensagem dela desde que você abriu este chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自你打开此聊天以来，对方没有发送任何消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自你開啟此聊天室以來，對方沒有發送任何訊息。"
          }
        }
      }
    },
    "They can't chat here until a moderator unbans them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kann nicht gechattet werden, bis ein Moderator die Sperre aufhebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede chatear aquí hasta que un moderador lo desbloquee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne peut pas discuter ici tant qu'un modérateur ne la débannit pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può chattare qui finché un moderatore non lo sbanna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデレーターが解除するまで、このチャットでは発言できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모더레이터가 차단을 해제하기 전까지 이 채팅에서 대화할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie może pisać na tym czacie, dopóki moderator go nie odbanuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode conversar aqui até um moderador desbani-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在被版主解封之前，无法在此聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在版主解除停權前，無法在此聊天。"
          }
        }
      }
    },
