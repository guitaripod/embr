        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 항목이 없어요. 보류된 메시지가 여기에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting venter. Tilbakeholdte meldinger vises her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie czeka. Wstrzymane wiadomości pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aguardando. Mensagens retidas aparecem aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget väntar. Hållna meddelanden visas här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的内容。被拦截的消息会显示在这里。"
