    "Join %lld Founding Supporters. One purchase, yours on every device with your Apple Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde einer von %lld Gründungsunterstützern. Ein Kauf, auf jedem Gerät mit deinem Apple-Account nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a %lld miembros fundadores. Una sola compra, tuya en todos tus dispositivos con tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez %lld Membres fondateurs. Un seul achat, à vous sur tous vos appareils avec votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a %lld Sostenitori fondatori. Un solo acquisto, tuo su tutti i dispositivi con il tuo Account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld人の創設サポーターに加わりましょう。一度の購入で、同じApple アカウントのすべてのデバイスで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld명의 창립 후원자와 함께하세요. 한 번만 구매하면 Apple 계정으로 로그인한 모든 기기에서 사용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do %lld Założycielskich Wspierających. Jeden zakup, dostępny na każdym urządzeniu z kontem Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a %lld Apoiadores Fundadores. Uma compra, sua em todos os dispositivos com sua Conta Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 位创始支持者加入。一次购买，使用你的 Apple 账户即可在每台设备上使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 位創始支持者加入。一次購買，使用你的 Apple 帳號即可在每台裝置上使用。"
          }
        }
      }
    },
