          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple Account는 아직 창립 멤버를 구매하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Apple-kontoen har ikke kjøpt Stiftende medlem ennå."
          }
        },
        "pl": {
