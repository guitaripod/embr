    "Messages containing this word or phrase will be hidden from chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit diesem Wort oder dieser Wendung werden im Chat ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages contenant ce mot ou cette expression seront masqués dans le chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes que contengan esta palabra o frase se ocultarán del chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi che contengono questa parola o frase verranno nascosti nella chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この単語やフレーズを含むメッセージはチャットに表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어나 문구가 포함된 메시지는 채팅에서 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含该词语或短语的消息将不会显示在聊天中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含這個字詞或短句的訊息將不會顯示在聊天室中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens que contiverem esta palavra ou frase ficarão ocultas no chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości zawierające to słowo lub wyrażenie będą ukrywane w czacie."
          }
        }
      }
    },
