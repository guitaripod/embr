    "One purchase, yours on every device with your Apple Account. Founding numbers go in order and stay yours.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét køb, der er dit på alle enheder med din Apple-konto. Stifternumre tildeles i rækkefølge og forbliver dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf, auf jedem Gerät mit deinem Apple-Account nutzbar. Gründungsnummern werden der Reihe nach vergeben und gehören dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra, tuya en todos tus dispositivos con tu cuenta de Apple. Los números de fundador se asignan en orden y son tuyos para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi osto, joka on käytettävissäsi kaikilla laitteillasi Apple-tilisi kautta. Perustajanumerot myönnetään järjestyksessä ja pysyvät sinulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat, à vous sur tous vos appareils avec votre compte Apple. Les numéros de fondateur sont attribués dans l'ordre et restent les vôtres."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitt kaup, þitt á hverju tæki með Apple-aðgangi þínum. Stofnunarnúmer fara í röð og haldast þín."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto, tuo su tutti i dispositivi con il tuo Account Apple. I numeri di fondatore vengono assegnati in ordine e restano tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、同じApple アカウントのすべてのデバイスで使えます。創設番号は購入順に付き、ずっとあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 구매하면 Apple 계정으로 로그인한 모든 기기에서 사용할 수 있습니다. 창립 번호는 순서대로 부여되며 계속 본인의 것으로 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kjøp, ditt på alle enheter med Apple-kontoen din. Stifternumre deles ut fortløpende og er dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup, dostępny na każdym urządzeniu z kontem Apple. Numery założycielskie przydzielamy po kolei i zostają przy tobie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra, sua em todos os dispositivos com sua Conta Apple. Os números de fundador são dados em ordem e ficam com você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett köp som gäller på alla enheter med ditt Apple-konto. Grundarnummer delas ut i ordning och förblir dina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，使用你的 Apple 账户即可在每台设备上使用。创始编号按顺序发放，并永久归你所有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，使用你的 Apple 帳號即可在每台裝置上使用。創始編號依序發放，並永久屬於你。"
          }
        }
      }
    },
