    "Playback stopped. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe gestoppt. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture interrompue. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha detenido la reproducción. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduzione interrotta. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が停止しました。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 중단되었습니다. 연결 상태를 확인한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已停止。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已停止。請檢查網路連線後再試一次。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução parou. Verifique sua conexão e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie zatrzymane. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilningen stoppede. Tjek din forbindelse, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisto pysähtyi. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilun stöðvuð. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avspillingen stoppet. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppspelningen stoppades. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
