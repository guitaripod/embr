    "That didn't work. Try again in a moment.": {
      "comment": "Studio toast",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det virkede ikke. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha funcionado. Vuelve a intentarlo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei onnistunut. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n'a pas marché. Réessayez dans un instant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það gekk ekki. Reyndu aftur eftir smástund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha funzionato. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。少し時間をおいて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 되지 않았어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gikk ikke. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não funcionou. Tente novamente em instantes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte. Försök igen om en stund."
          }
