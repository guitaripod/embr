          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ba om å vente litt. Prøv igjen snart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch poprosił o chwilę cierpliwości. Spróbuj ponownie za moment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch pediu para aguardar um momento. Tente novamente em breve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bad om att få vänta en stund. Försök igen strax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 要求稍等片刻，请稍后再试。"
          }
