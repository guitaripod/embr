    "Pay once. Yours on every device signed in to your Apple Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal bezahlen. Gehört dir auf jedem Gerät, auf dem du mit deinem Apple Account angemeldet bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único. Tuyo en todos los dispositivos con sesión iniciada en tu Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement. Vous l'avez sur chaque appareil connecté à votre Apple Account."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pagamento. Tuo su ogni dispositivo connesso al tuo Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度のお支払いで、Apple Accountにサインインしたすべてのデバイスで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 결제하면 Apple Account에 로그인한 모든 기기에서 사용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność. Twoje na każdym urządzeniu zalogowanym na konto Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único. Seu em todos os dispositivos conectados à sua Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付费，登录同一 Apple Account 的所有设备均可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付費，登入同一 Apple Account 的所有裝置均可使用。"
          }
        }
      }
    },
