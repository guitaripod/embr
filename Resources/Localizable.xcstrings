    "Follow channels, join chat and get live alerts.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg kanaler, deltag i chatten og modtag live-notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle folgen, am Chat teilnehmen und Live-Benachrichtigungen erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue canales, únete al chat y recibe alertas en directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa kanavia, liity chatiin ja saa live-ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des chaînes, rejoignez le chat et recevez des alertes en direct."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fylgstu með rásum, taktu þátt í spjalli og fáðu tilkynningar í beinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui canali, partecipa alla chat e ricevi avvisi in diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルをフォローして、チャットに参加し、配信開始の通知を受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채널을 팔로우하고, 채팅에 참여하고, 라이브 알림을 받으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg kanaler, bli med i chatten og få direktevarsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj kanały, dołączaj do czatu i otrzymuj powiadomienia o transmisjach na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga canais, participe do chat e receba alertas ao vivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ kanaler, delta i chatten och få notiser när de är live."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注频道、加入聊天，并接收开播提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤頻道、加入聊天，並接收開台提醒。"
          }
        }
      }
    },
