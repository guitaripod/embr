    "No messages from them since you opened this chat.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen beskeder fra dem, siden du åbnede denne chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit du diesen Chat geöffnet hast, gibt es keine Nachrichten von ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay mensajes de esta persona desde que abriste este chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei viestejä heiltä sen jälkeen, kun avasit tämän chatin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message de cette personne depuis l'ouverture de ce chat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin skilaboð frá þeim síðan þú opnaðir þetta spjall."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun messaggio da parte loro da quando hai aperto questa chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを開いてから、この人の発言はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅을 연 후로 이 사용자의 메시지가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen meldinger fra dem siden du åpnet denne chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od otwarcia tego czatu nie ma od nich żadnych wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mensagem dela desde que você abriu este chat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga meddelanden från dem sedan du öppnade den här chatten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自你打开此聊天以来，对方没有发送任何消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自你開啟此聊天室以來，對方沒有發送任何訊息。"
          }
        }
      }
    },
    "They can't chat here until a moderator unbans them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke chatte her, før en moderator ophæver udelukkelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kann nicht gechattet werden, bis ein Moderator die Sperre aufhebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede chatear aquí hasta que un moderador lo desbloquee."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjä ei voi chatata täällä, ennen kuin moderaattori poistaa porttikiellon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne peut pas discuter ici tant qu'un modérateur ne la débannit pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Viðkomandi getur ekki spjallað hér fyrr en umsjónarmaður aflétti banninu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può chattare qui finché un moderatore non lo sbanna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデレーターが解除するまで、このチャットでは発言できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모더레이터가 차단을 해제하기 전까지 이 채팅에서 대화할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke chatte her før en moderator opphever utestengelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie może pisać na tym czacie, dopóki moderator go nie odbanuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode conversar aqui até um moderador desbani-lo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan inte chatta här förrän en moderator avbannar dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在被版主解封之前，无法在此聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在版主解除停權前，無法在此聊天。"
          }
        }
      }
    },
