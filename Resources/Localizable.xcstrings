    "No blocked users.\nBlock someone from a chat message to hide them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine blockierten Nutzer.\nBlockiere jemanden über eine Chat-Nachricht, um ihn auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun utilisateur bloqué.\nBloquez quelqu'un depuis un message du chat pour le masquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay usuarios bloqueados.\nBloquea a alguien desde un mensaje del chat para ocultarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun utente bloccato.\nBlocca qualcuno da un messaggio in chat per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしたユーザーはいません。\nチャットのメッセージからブロックすると非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 사용자가 없습니다.\n채팅 메시지에서 차단하면 해당 사용자가 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已屏蔽的用户。\n在聊天消息上屏蔽某人即可隐藏其消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已封鎖的使用者。\n在聊天訊息上封鎖某人即可隱藏對方。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum usuário bloqueado.\nBloqueie alguém a partir de uma mensagem do chat para ocultá-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zablokowanych użytkowników.\nZablokuj kogoś z poziomu wiadomości czatu, aby go ukryć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen blokerede brugere.\nBlokér en person fra en chatbesked for at skjule dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei estettyjä käyttäjiä.\nEstä joku chat-viestistä piilottaaksesi hänet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engir lokaðir notendur.\nLokaðu á einhvern úr skilaboði í spjallinu til að fela hann."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen blokkerte brukere.\nBlokker noen fra en chat-melding for å skjule dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga blockerade användare.\nBlockera någon från ett chattmeddelande för att dölja dem."
          }
        }
      }
    },
