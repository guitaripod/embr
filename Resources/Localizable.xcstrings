    "Twitch can't be reached right now. Check the Apple TV's network connection.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch kan ikke nås lige nu. Tjek netværksforbindelsen på Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ist gerade nicht erreichbar. Prüfe die Netzwerkverbindung des Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a Twitch ahora mismo. Comprueba la conexión de red del Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitchiin ei saada yhteyttä juuri nyt. Tarkista Apple TV:n verkkoyhteys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Twitch pour le moment. Vérifiez la connexion réseau de l'Apple TV."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við Twitch eins og er. Athugaðu nettenginguna á Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere Twitch al momento. Controlla la connessione di rete dell'Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在Twitchに接続できません。Apple TVのネットワーク接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Twitch에 연결할 수 없습니다. Apple TV의 네트워크 연결을 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch kan ikke nås akkurat nå. Sjekk nettverkstilkoblingen til Apple TV-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz połączyć się z Twitch. Sprawdź połączenie sieciowe Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a Twitch agora. Verifique a conexão de rede da Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch går inte att nå just nu. Kontrollera Apple TV:ns nätverksanslutning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法连接 Twitch。请检查 Apple TV 的网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連線到 Twitch。請檢查 Apple TV 的網路連線。"
          }
        }
      }
    },
