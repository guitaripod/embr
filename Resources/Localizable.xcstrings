    "Choose where Embr opens, what the Top tab shows, and what it remembers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wo Embr startet, was der Top-Tab zeigt und woran sich die App erinnert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où Embr s'ouvre, ce que montre l'onglet Top et ce dont l'app se souvient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde se abre Embr, qué muestra la pestaña Top y qué recuerda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove si apre Embr, cosa mostra la scheda Top e cosa ricorda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Embrを開いたときの画面、トップタブの表示内容、記憶する履歴を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr가 열릴 화면, 인기 탭에 표시할 내용, 기억할 항목을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Embr 打开时的页面、热门标签显示的内容以及要保留的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Embr 開啟時的頁面、熱門標籤顯示的內容，以及要保留的記錄。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde o Embr abre, o que a aba Top mostra e o que ele lembra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie otwiera się Embr, co pokazuje karta Popularne i co aplikacja pamięta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvor Embr åbner, hvad fanen Top viser, og hvad appen husker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mihin Embr avautuu, mitä Suosituimmat-välilehti näyttää ja mitä se muistaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu hvar Embr opnast, hvað Vinsælust-flipinn sýnir og hvað forritið man."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvor Embr åpnes, hva Topp-fanen viser, og hva appen husker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj var Embr öppnas, vad fliken Topp visar och vad appen minns."
          }
        }
      }
    },
