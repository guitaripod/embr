    "A single word matches on its own, a phrase anywhere in a message. Case and accents don't matter.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt ord matcher på egen hånd, en sætning hvor som helst i en besked. Store og små bogstaver og accenter har ingen betydning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Wort passt für sich allein, eine Wendung überall in einer Nachricht. Groß- und Kleinschreibung sowie Akzente spielen keine Rolle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola palabra coincide por sí misma; una frase, en cualquier parte del mensaje. No importan mayúsculas ni acentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksittäinen sana täsmää sellaisenaan, ja ilmaisu täsmää missä tahansa viestissä. Kirjainkoolla ja tarkkeilla ei ole merkitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot seul correspond à lui-même, une expression correspond n'importe où dans un message. La casse et les accents ne comptent pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitt orð passar eitt og sér, en orðasamband passar hvar sem er í skilaboðum. Stafastærð og broddstafir skipta ekki máli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola singola corrisponde da sola, una frase ovunque nel messaggio. Maiuscole e accenti non contano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語は単独で一致し、フレーズはメッセージ内のどこにあっても一致します。大文字・小文字とアクセント記号は区別されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 하나는 그 자체로 일치하고, 문구는 메시지 어디에 있든 일치합니다. 대소문자와 악센트는 무시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt ord treffer på egen hånd, og et uttrykk hvor som helst i en melding. Store og små bokstaver og aksenter spiller ingen rolle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedyncze słowo pasuje samo, a wyrażenie gdziekolwiek w wiadomości. Wielkość liter i akcenty nie mają znaczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra sozinha confere por si só, e uma frase em qualquer parte da mensagem. Maiúsculas e acentos não importam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett enda ord matchar på egen hand, en fras matchar var som helst i ett meddelande. Stora och små bokstäver och accenter spelar ingen roll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个词语会单独匹配，短语则可出现在消息的任何位置。不区分大小写和重音符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一字詞會單獨比對，短句則可出現在訊息的任何位置。不區分大小寫和重音符號。"
          }
        }
      }
    },
