    "Snooze and run ad breaks, alert sounds, the stream recap, moderator mode and quick messages, on every device.": {
      "comment": "Studio Pro settings",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udsæt og start reklamepauser, notifikationslyde, streamoversigten, moderatortilstand og hurtigbeskeder, på alle enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepausen verschieben und starten, Alarmtöne, die Stream-Zusammenfassung, Moderatormodus und Schnellnachrichten, auf allen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaza y lanza cortes publicitarios, sonidos de alerta, el resumen del directo, el modo moderador y los mensajes rápidos, en todos los dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykkää ja aloita mainostauot, ilmoitusäänet, striimin yhteenveto, moderaattoritila ja pikaviestit kaikilla laitteilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter et lancer des pauses publicitaires, sons d'alerte, récapitulatif du live, mode modérateur et messages rapides, sur tous vos appareils."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresta og hefja auglýsingahlé, hljóð tilkynninga, samantekt útsendingar, umsjónarhaminn og flýtiskilaboð á öllum tækjum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posticipa e avvia le pubblicità, suoni degli avvisi, riepilogo della diretta, modalità moderatore e messaggi rapidi, su ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CM ブレイクのスヌーズと放送、アラート音、配信の振り返り、モデレーターモード、クイックメッセージを、すべてのデバイスで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 광고 시간 미루기와 실행, 알림음, 방송 요약, 모더레이터 모드, 빠른 메시지를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utsett og start reklamepauser, varsellyder, streamoppsummeringen, moderatormodus og hurtigmeldinger, på alle enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkładanie i uruchamianie przerw na reklamy, dźwięki alertów, podsumowanie transmisji, tryb moderatora i szybkie wiadomości na każdym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiar e exibir intervalos de anúncios, sons de alerta, o resumo da transmissão, o modo moderador e as mensagens rápidas, em todos os dispositivos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut upp och starta annonspauser, larmljud, streamsammanfattningen, moderatorläge och snabbmeddelanden, på alla enheter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有设备上延后并播放广告插播，同时使用提醒音效、直播回顾、管理员模式和快捷消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每台裝置上延後及播放廣告插播、提示音、直播回顧、版主模式和快速訊息。"
          }
        }
      }
    },
    "Snooze and run ad breaks, alert sounds, the stream recap, moderator mode and quick messages, on iPhone, iPad and Apple TV.": {
      "comment": "Studio settings footer",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udsæt og start reklamepauser, notifikationslyde, streamoversigten, moderatortilstand og hurtigbeskeder, på iPhone, iPad og Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepausen verschieben und starten, Alarmtöne, die Stream-Zusammenfassung, Moderatormodus und Schnellnachrichten, auf iPhone, iPad und Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaza y lanza cortes publicitarios, sonidos de alerta, el resumen del directo, el modo moderador y los mensajes rápidos, en iPhone, iPad y Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykkää ja aloita mainostauot, ilmoitusäänet, striimin yhteenveto, moderaattoritila ja pikaviestit iPhonella, iPadilla ja Apple TV:llä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter et lancer des pauses publicitaires, sons d'alerte, récapitulatif du live, mode modérateur et messages rapides, sur iPhone, iPad et Apple TV."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresta og hefja auglýsingahlé, hljóð tilkynninga, samantekt útsendingar, umsjónarhaminn og flýtiskilaboð á iPhone, iPad og Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posticipa e avvia le pubblicità, suoni degli avvisi, riepilogo della diretta, modalità moderatore e messaggi rapidi, su iPhone, iPad e Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CM ブレイクのスヌーズと放送、アラート音、配信の振り返り、モデレーターモード、クイックメッセージを、iPhone、iPad、Apple TV で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad, Apple TV에서 광고 시간 미루기와 실행, 알림음, 방송 요약, 모더레이터 모드, 빠른 메시지를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utsett og start reklamepauser, varsellyder, streamoppsummeringen, moderatormodus og hurtigmeldinger, på iPhone, iPad og Apple TV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkładanie i uruchamianie przerw na reklamy, dźwięki alertów, podsumowanie transmisji, tryb moderatora i szybkie wiadomości na iPhonie, iPadzie i Apple TV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiar e exibir intervalos de anúncios, sons de alerta, o resumo da transmissão, o modo moderador e as mensagens rápidas, no iPhone, iPad e Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut upp och starta annonspauser, larmljud, streamsammanfattningen, moderatorläge och snabbmeddelanden, på iPhone, iPad och Apple TV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone、iPad 和 Apple TV 上延后并播放广告插播，同时使用提醒音效、直播回顾、管理员模式和快捷消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone、iPad 和 Apple TV 上延後及播放廣告插播、提示音、直播回顧、版主模式和快速訊息。"
          }
        }
      }
    },
    "Snooze it on the ad clock, or let it run.": {
      "comment": "Studio ad soon banner",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udsæt den på reklameuret, eller lad den køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe sie auf der Werbeuhr oder lass sie laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplázalo en el reloj de anuncios o déjalo correr."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykkää se mainoskellosta tai anna sen alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reportez-la sur l'horloge publicitaire, ou laissez-la se lancer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frestaðu henni á auglýsingaklukkunni eða leyfðu henni að hefjast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posticipala dall'orologio delle pubblicità, o lasciala andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CM 時計でスヌーズするか、そのまま放送させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 시계에서 미루거나 그대로 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utsett den på reklameklokken, eller la den gå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż ją na zegarze reklam albo pozwól jej się rozpocząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adie no relógio de anúncios ou deixe rodar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjut upp den på annonsklockan, eller låt den köra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在广告时钟上延后，或让它正常播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在廣告時鐘上延後，或讓它照常播放。"
