            "state": "translated",
            "value": "Ten Apple Account nie kupił jeszcze Członka Założyciela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple Account ainda não comprou o Membro Fundador."
          }
        },
        "sv": {
