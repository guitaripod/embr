    "Paused — tap play to return to live": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert — tippe auf Play, um zu Live zurückzukehren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause — touchez lecture pour revenir au direct"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: toca reproducir para volver al directo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa — tocca play per tornare in diretta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中 — 再生をタップするとライブに戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시정지됨 — 재생을 누르면 실시간으로 돌아갑니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停 — 点按播放即可回到直播"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停 — 點一下播放即可回到直播"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado — toque em reproduzir para voltar à transmissão ao vivo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano — stuknij odtwarzanie, aby wrócić do na żywo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause. Tryk på afspil for at vende tilbage til live."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty – palaa liveen napauttamalla toistopainiketta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í hléi – pikkaðu á spilunarhnappinn til að fara aftur í beina útsendingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauset. Trykk på Spill av for å gå tilbake til direkte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad – tryck på spela upp för att återgå till live"
          }
        }
      }
    },
