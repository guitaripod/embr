    "Even with Twitch Turbo or a channel sub — here's what's happening.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch mit Twitch Turbo oder einem Kanal-Abo — hier steht, warum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même avec Twitch Turbo ou un abonnement à la chaîne — voici pourquoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso con Twitch Turbo o una suscripción al canal: esto es lo que pasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche con Twitch Turbo o un abbonamento al canale: ecco cosa succede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch Turbo やチャンネルサブスクに入っていても表示される理由はこちら。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch Turbo나 채널 구독이 있어도 광고가 나오는 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使有 Twitch Turbo 或频道订阅——原因在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
