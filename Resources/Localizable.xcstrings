    "Click to make it large. Press and hold for options.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um es zu vergrößern. Gedrückt halten für Optionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
