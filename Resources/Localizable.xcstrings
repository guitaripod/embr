    "If your microphone can hear this device, turn sounds off so they don't reach your stream.": {
      "comment": "Studio settings footer",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din mikrofon kan høre denne enhed, så slå lydene fra, så de ikke kommer med i din stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Mikrofon dieses Gerät hören kann, schalte die Töne aus, damit sie nicht in deinen Stream gelangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu micrófono puede oír este dispositivo, desactiva los sonidos para que no lleguen a tu directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos mikrofoni kuulee tämän laitteen, mykistä äänet, etteivät ne päädy striimiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre micro entend cet appareil, désactivez les sons pour qu'ils n'arrivent pas dans votre stream."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef hljóðneminn getur heyrt í þessu tæki skaltu slökkva á hljóðum svo þau berist ekki út í streymið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il microfono sente questo dispositivo, disattiva i suoni così non arrivano alla diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクがこの端末の音を拾う場合は、配信に入らないようサウンドをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 이 기기 소리를 들을 수 있다면, 방송으로 소리가 전달되지 않도록 소리를 꺼 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis mikrofonen din kan høre denne enheten, slå av lydene slik at de ikke når streamen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli mikrofon słyszy to urządzenie, wyłącz dźwięki, aby nie trafiały do transmisji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu microfone conseguir ouvir este dispositivo, desligue os sons para que não cheguem à sua transmissão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om din mikrofon kan höra den här enheten, stäng av ljuden så att de inte når din stream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的麦克风能听到此设备，请关闭声音，以免被直播画面收录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果麥克風能聽到這台裝置，請關閉提示音，以免被收進你的直播。"
          }
        }
      }
    },
