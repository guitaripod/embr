    "Nothing waiting. Held messages show up here.": {
      "comment": "Studio moderation card, empty",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet venter. Tilbageholdte beskeder vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet. Zurückgehaltene Nachrichten erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada pendiente. Los mensajes retenidos aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei odottavia. Pidätetyt viestit näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en attente. Les messages retenus apparaissent ici."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert í bið. Haldin skilaboð birtast hér."
          }
