    "Pick what Studio may read and do on your channel. Twitch asks you to approve exactly these on your phone. You can change them later in Settings.": {
      "comment": "Studio permissions screen",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvad Studio må læse og gøre på din kanal. Twitch beder dig godkende netop disse på din telefon. Du kan ændre dem senere under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was Studio in deinem Kanal lesen und tun darf. Twitch bittet dich, genau diese auf deinem Telefon zu bestätigen. Du kannst sie später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige lo que Studio puede leer y hacer en tu canal. Twitch te pedirá que apruebes exactamente estos en tu teléfono. Puedes cambiarlos más tarde en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä Studio saa lukea ja tehdä kanavallasi. Twitch pyytää sinua hyväksymään juuri nämä puhelimellasi. Voit muuttaa niitä myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que Studio peut lire et faire sur votre chaîne. Twitch vous demande d'approuver exactement ces autorisations sur votre téléphone. Vous pourrez les modifier plus tard dans Réglages."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu hvað Studio má lesa og gera á rásinni þinni. Twitch biður þig um að samþykkja nákvæmlega þetta í símanum. Þú getur breytt þessu síðar í Stillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa Studio può leggere e fare sul tuo canale. Twitch ti chiede di approvare esattamente queste sul telefono. Puoi cambiarle più tardi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio がチャンネルで読み取りや操作を行える範囲を選んでください。Twitch からスマートフォンで、これらの内容の承認を求められます。後から設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio가 내 채널에서 읽고 할 수 있는 작업을 고르세요. Twitch가 휴대폰에서 이 권한들을 승인하도록 요청해요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hva Studio kan lese og gjøre på kanalen din. Twitch ber deg godkjenne akkurat disse på telefonen. Du kan endre dem senere i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, co Studio może czytać i robić na twoim kanale. Twitch poprosi cię o zatwierdzenie dokładnie tych uprawnień w telefonie. Możesz je zmienić później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que o Studio pode ler e fazer no seu canal. A Twitch pede que você aprove exatamente estas no seu celular. Você pode alterá-las depois em Ajustes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vad Studio får läsa och göra på din kanal. Twitch ber dig godkänna exakt dessa på din telefon. Du kan ändra dem senare i Inställningar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Studio 可在你的频道上读取和执行的操作。Twitch 会要求你在手机上逐一确认这些权限。之后可在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Studio 可以在你的頻道上讀取和執行哪些操作。Twitch 會請你在手機上確認這些權限。之後可以在「設定」中變更。"
          }
        }
      }
    },
