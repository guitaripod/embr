          }
        }
      }
    },
    "Thank you. Your accent color tints Embr on every device signed in to your Apple Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Deine Akzentfarbe färbt Embr auf jedem Gerät, auf dem du mit deinem Apple Account angemeldet bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Tu color de acento tiñe Embr en todos los dispositivos con sesión iniciada en tu Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Votre couleur d'accent colore Embr sur chaque appareil connecté à votre Apple Account."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Il tuo colore di accento tinge Embr su ogni dispositivo connesso al tuo Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。アクセントカラーは、Apple Accountにサインインしたすべてのデバイスで Embr に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 강조 색상은 Apple Account에 로그인한 모든 기기의 Embr에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy. Twój kolor akcentu koloruje Embr na każdym urządzeniu zalogowanym na konto Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Sua cor de destaque aparece no Embr em todos os dispositivos conectados à sua Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你的支持。你的强调色会应用到所有登录同一 Apple Account 的设备上的 Embr。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝你的支持。你的強調色會套用到所有登入同一 Apple Account 的裝置上的 Embr。"
          }
        }
      }
    },
    "The purchase finishes once it's approved.": {
      "localizations": {
