    "You can also tap a name in chat and choose Highlight.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også trykke på et navn i chatten og vælge Fremhæv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch auf einen Namen im Chat tippen und Hervorheben wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes tocar un nombre en el chat y elegir Resaltar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös napauttaa nimeä chatissa ja valita Korosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi appuyer sur un nom dans le chat et choisir Surligner."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur líka pikkað á nafn í spjallinu og valið Auðkenna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche toccare un nome in chat e scegliere Evidenzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで名前をタップして「強調」を選ぶこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 이름을 탭하고 강조를 선택할 수도 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også trykke på et navn i chatten og velge Fremhev."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też dotknąć nazwy na czacie i wybrać Wyróżnij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode tocar em um nome no chat e escolher Destacar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan också trycka på ett namn i chatten och välja Markera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
