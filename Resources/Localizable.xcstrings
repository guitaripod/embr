          }
        }
      }
    },
    "Your badge couldn't be turned on yet. Embr tries again next time it opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abzeichen konnte noch nicht aktiviert werden. Embr versucht es beim nächsten Öffnen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se pudo activar tu insignia. Embr lo volverá a intentar la próxima vez que se abra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre badge n'a pas pu être activé pour le moment. Embr réessaie la prochaine fois qu'il s'ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile attivare il distintivo. Embr riprova la prossima volta che si apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジをまだ有効にできませんでした。次回Embrを開いたときに再度試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배지를 아직 켤 수 없습니다. Embr은 다음에 열 때 다시 시도합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się jeszcze włączyć odznaki. Embr spróbuje ponownie przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi possível ativar seu selo. O Embr tenta de novo na próxima vez que for aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法开启你的徽章。下次打开 Embr 时会再次尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法開啟你的徽章。下次開啟 Embr 時會再次嘗試。"
          }
        }
      }
    },
