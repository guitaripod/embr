    "Twitch asked to wait a moment. Try again shortly.": {
      "comment": "Studio error",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bad om at vente et øjeblik. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bat um einen Moment Geduld. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ha pedido esperar un momento. Vuelve a intentarlo en breve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch pyysi odottamaan hetken. Yritä kohta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
