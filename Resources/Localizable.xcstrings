    "A good moment to stretch or talk to chat.": {
      "comment": "Studio ads running banner",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et godt tidspunkt til at strække benene eller snakke med chatten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein guter Moment, um dich zu strecken oder mit dem Chat zu plaudern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen momento para estirarte o hablar con el chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvä hetki venytellä tai jutella chatille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bon moment pour vous étirer ou parler au chat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gott tækifæri til að teygja úr sér eða spjalla við áhorfendur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un buon momento per sgranchirti o parlare in chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレッチするか、チャットに話しかけるのにちょうどいいタイミングです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 스트레칭하거나 채팅과 이야기하기 좋은 순간이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et godt øyeblikk til å strekke på seg eller prate med chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobry moment, żeby się przeciągnąć albo porozmawiać z czatem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bom momento para se alongar ou falar com o chat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett bra läge att sträcka på benen eller prata med chatten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正是伸展一下或和聊天室聊聊的好时机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是伸展一下或跟聊天室聊聊的好時機。"
          }
        }
      }
    },
