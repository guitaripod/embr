    "Log in with Twitch in Settings to show your badge in chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen bei Twitch an, um dein Abzeichen im Chat zu zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Twitch en Ajustes para mostrar tu insignia en el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Twitch dans les Réglages pour afficher votre badge dans le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Twitch nelle Impostazioni per mostrare il tuo badge in chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でTwitchにログインすると、チャットにバッジを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Twitch에 로그인하면 채팅에 내 배지가 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na Twitchu w Ustawieniach, aby pokazać odznakę na czacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com a Twitch nos Ajustes para mostrar seu selo no chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中登录 Twitch，即可在聊天中显示你的徽章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中登入 Twitch，即可在聊天中顯示你的徽章。"
          }
        }
      }
    },
