            "state": "translated",
            "value": "Erhalte eine Mitteilung, sobald ein Kanal, dem du folgst, live geht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification quand une chaîne que vous suivez passe en direct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación cuando un canal que sigues empiece a emitir."
          }
        },
        "it": {
