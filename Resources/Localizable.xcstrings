          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto si completa una volta approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認された時点で完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인되면 구매가 완료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet fullføres når det er godkjent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup zakończy się po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
