    "Slow down — too many requests": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsamer — zu viele Anfragen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doucement — trop de requêtes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más despacio: demasiadas solicitudes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rallenta — troppe richieste"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し待ってください — リクエストが多すぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도하세요 — 요청이 너무 많습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请慢一点 — 请求过多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢一點 — 請求過多"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá com calma — solicitações demais"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwolnij — zbyt wiele żądań"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt farten ned, for mange anmodninger"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidasta, liian monta pyyntöä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hægðu á þér, of margar beiðnir"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk farten – for mange forespørsler"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakta ner, för många förfrågningar"
          }
        }
      }
    },
