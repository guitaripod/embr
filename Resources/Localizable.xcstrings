          }
        }
      }
    },
    "Twitch didn't allow it. Check Studio's permissions in Settings.": {
      "comment": "Studio error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch hat das nicht erlaubt. Prüfe Studios Berechtigungen in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch no lo ha permitido. Revisa los permisos de Studio en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
