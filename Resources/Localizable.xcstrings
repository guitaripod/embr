    "Sounds play through the TV. If your microphone can hear the TV, keep them off so they don't reach your stream.": {
      "comment": "Settings section",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyde afspilles gennem fjernsynet. Hvis din mikrofon kan høre fjernsynet, så slå dem fra, så de ikke havner i din stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Töne werden über den Fernseher abgespielt. Wenn dein Mikrofon den Fernseher hören kann, lass sie aus, damit sie nicht in deinen Stream gelangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos se reproducen por el televisor. Si tu micrófono puede oír el televisor, mantenlos desactivados para que no lleguen a tu directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänet toistetaan television kautta. Jos mikrofoni kuulee television, pidä äänet pois päältä, jotta ne eivät päädy striimiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons passent par la télé. Si votre micro entend la télé, gardez-les désactivés pour qu'ils n'arrivent pas dans votre stream."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hljóðin koma úr sjónvarpinu. Ef hljóðneminn þinn heyrir í sjónvarpinu skaltu slökkva á þeim svo þau berist ekki út í útsendinguna þína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoni vengono riprodotti dalla TV. Se il microfono sente la TV, tienili disattivati così non arrivano alla diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音はテレビから再生されます。マイクがテレビの音を拾う場合は、配信に入らないようオフにしておいてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 TV로 재생돼요. 마이크가 TV 소리를 들을 수 있다면, 방송으로 전달되지 않도록 끄세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd spilles av gjennom TV-en. Hvis mikrofonen kan høre TV-en, slå lyden av så den ikke havner i streamen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięki odtwarzane są przez telewizor. Jeśli mikrofon słyszy telewizor, wyłącz je, aby nie trafiały do transmisji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons tocam pela TV. Se o seu microfone conseguir ouvir a TV, mantenha-os desligados para que não cheguem à sua transmissão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljuden spelas upp genom TV:n. Om din mikrofon kan höra TV:n, stäng av dem så att de inte hamnar i din stream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音通过电视播放。如果你的麦克风能听到电视声音，请保持关闭，以免被直播画面收录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示音會透過電視播放。如果麥克風能聽到電視，請關閉提示音，以免被收進你的直播。"
          }
        }
      }
    },
