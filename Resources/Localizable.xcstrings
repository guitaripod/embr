          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 이메일을 보내주세요.\n\n주소가 클립보드에 복사되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请发送邮件至 %@\n\n地址已复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請寄信至 %@\n\n地址已拷貝到剪貼板。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um e-mail para %@\n\nO endereço foi copiado para a área de transferência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz e-mail na %@\n\nAdres został skopiowany do schowka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail %@\n\nAdressen er kopieret til udklipsholderen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä sähköposti osoitteeseen %@\n\nOsoite on kopioitu leikepöydälle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Senda tölvupóst á %@\n\nNetfangið hefur verið afritað á klippiborðið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send e-post til %@\n\nAdressen er kopiert til utklippstavlen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka e-post till %@\n\nAdressen kopierades till urklipp."
          }
        }
      }
    },
