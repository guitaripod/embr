    "You can also tap a name in chat and choose Highlight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch auf einen Namen im Chat tippen und Hervorheben wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes tocar un nombre en el chat y elegir Resaltar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi appuyer sur un nom dans le chat et choisir Surligner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche toccare un nome in chat e scegliere Evidenzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで名前をタップして「強調」を選ぶこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 이름을 탭하고 강조를 선택할 수도 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też dotknąć nazwy na czacie i wybrać Wyróżnij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode tocar em um nome no chat e escolher Destacar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在聊天中点按用户名，然后选择“高亮”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在聊天室中點按使用者名稱，然後選擇「標示」。"
