    "Viewers see ads for the length you pick. Breaks over 90 seconds lose more viewers.": {
      "comment": "Studio run ad sheet",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seerne får reklamer i den længde, du vælger. Pauser over 90 sekunder mister flere seere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschauer sehen Werbung in der Länge, die du wählst. Pausen über 90 Sekunden verlieren mehr Zuschauer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espectadores ven anuncios de la duración que elijas. Los cortes de más de 90 segundos pierden más espectadores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsojat näkevät mainoksia valitsemanasi pituisina. Yli 90 sekunnin mittaiset tauot karkottavat enemmän katsojia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les spectateurs voient des pubs de la durée choisie. Les pauses de plus de 90 secondes font perdre plus de spectateurs."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Áhorfendur sjá auglýsingar í þeirri lengd sem þú velur. Hlé sem eru lengri en 90 sekúndur missa fleiri áhorfendur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli spettatori vedono la pubblicità per la durata scelta. Le pause oltre 90 secondi fanno perdere più spettatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者は選んだ長さの CM を見ます。90 秒を超える CM ブレイクでは、視聴者がより多く離脱します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자는 고른 길이만큼 광고를 봐요. 90초를 넘는 광고 시간은 시청자를 더 잃어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seere ser reklame i lengden du velger. Pauser over 90 sekunder mister flere seere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widzowie oglądają reklamy o wybranej długości. Przerwy dłuższe niż 90 s tracą więcej widzów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espectadores veem anúncios pela duração escolhida. Intervalos acima de 90 segundos fazem mais espectadores saírem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittare ser annonser i den längd du väljer. Pauser över 90 sekunder tappar fler tittare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观众看到的广告时长即为你所选的时长。超过 90 秒的插播会流失更多观众。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀眾會看到你選擇長度的廣告。超過 90 秒的插播會流失更多觀眾。"
          }
        }
      }
    },
    "Waiting for approval. Studio Pro turns on when it's approved.": {
      "comment": "Paywall status",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkendelse. Studio Pro aktiveres, når den er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf Freigabe. Studio Pro wird aktiviert, sobald sie erteilt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Studio Pro se activa cuando se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan hyväksyntää. Studio Pro aktivoituu, kun se on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Studio Pro s'active une fois approuvé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíður samþykkis. Studio Pro kveikir þegar það hefur verið samþykkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Studio Pro si attiva quando viene approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されると Studio Pro がオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 대기 중이에요. 승인되면 Studio Pro가 켜져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkjenning. Studio Pro slås på når den er godkjent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Studio Pro włączy się po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O Studio Pro é ativado quando for aprovado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Studio Pro slås på när det har godkänts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
