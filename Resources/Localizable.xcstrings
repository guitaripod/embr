    "Quick messages post to your chat in one tap, from here or the Apple TV, where they arrive through iCloud.": {
      "comment": "Studio settings footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellnachrichten werden mit einem Tipp in deinem Chat gepostet, von hier oder vom Apple TV aus, wo sie über iCloud ankommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes rápidos se publican en tu chat con un toque, desde aquí o desde el Apple TV, donde llegan a través de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages rapides s'envoient dans votre chat d'une simple pression, d'ici ou depuis l'Apple TV, où ils arrivent via iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi rapidi vengono inviati alla chat con un tocco, da qui o da Apple TV, dove arrivano tramite iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックメッセージは、ここからでも Apple TV からでも、ワンタップでチャットに投稿されます。Apple TV へは iCloud 経由で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 메시지는 여기서 또는 Apple TV에서 한 번 탭하면 채팅에 올라가요. Apple TV의 메시지는 iCloud를 통해 전달돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie wiadomości trafiają na czat jednym dotknięciem, stąd lub z Apple TV, dokąd docierają przez iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens rápidas são enviadas ao seu chat com um toque, daqui ou da Apple TV, para onde chegam pelo iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷消息可一键发送到你的聊天中，既可在此处发送，也可在 Apple TV 上发送，并通过 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速訊息只要點一下就能發送到聊天室，可從這裡或 Apple TV 發送，並透過 iCloud 同步。"
          }
        }
      }
    },
