        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr — un cliente de Twitch nativo y rápido para iPhone, con emotes de 7TV, BTTV y FFZ en el chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr — un client Twitch nativo e veloce per iPhone, con le emote di 7TV, BTTV e FFZ in chat."
          }
