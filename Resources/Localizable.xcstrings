          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temi, colori di accento, font della chat e un badge a fiamma che tutti in Embr vedono accanto al tuo nome, con un numero di fondatore che resta tuo. Provali qui sotto: Studio non richiede nulla di tutto questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、アクセントカラー、チャットフォント、そしてEmbrのみんなに名前の横で見える炎のバッジと、ずっとあなたのものになる創設番号。下で試してみてください。Studioにこれらは一切必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 강조 색상, 채팅 글꼴, 그리고 Embr의 모든 사람이 내 이름 옆에서 보는 불꽃 배지와 계속 내 것으로 남는 창립 번호. 아래에서 미리 적용해 보세요. Studio에는 이 중 어떤 것도 필요하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer, aksentfarger, skrifttyper i chatten og et flammemerke som alle i Embr ser ved siden av navnet ditt, med et stifternummer som forblir ditt. Prøv dem nedenfor; Studio krever aldri noe av dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywy, kolory akcentu, czcionki czatu i odznaka płomienia, którą wszyscy w Embr widzą obok twojej nazwy, z numerem założycielskim, który zostaje przy tobie. Wypróbuj je poniżej. Studio nigdy niczego z tego nie wymaga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, cores de destaque, fontes do chat e um selo de chama que todo mundo no Embr vê ao lado do seu nome, com um número de fundador que fica com você. Experimente abaixo; o Studio nunca exige nada disso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman, accentfärger, chattens typsnitt och ett flammärke som alla i Embr ser bredvid ditt namn, med ett grundarnummer som förblir ditt. Prova dem nedan; Studio behöver aldrig något av det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、强调色、聊天字体，以及 Embr 中所有人都能在你名字旁看到的火焰徽章，还有永久归你所有的创始编号。可以在下方试用；Studio 从来不需要这些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題、強調色、聊天字體，以及 Embr 中所有人都能在你名字旁看到的火焰徽章，還有永久屬於你的創始編號。可以在下方試用；Studio 從來不需要這些。"
          }
        }
      }
    },
    "Everything here is yours to change any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt herunder kan du ændre når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles hier kannst du jederzeit ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que ves aquí es tuyo para cambiarlo cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkea täällä voit muuttaa milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ici vous appartient, à modifier à tout moment."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur breytt öllu hér hvenær sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto qui è tuo: puoi cambiarlo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにあるものは、いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 모든 것은 언제든지 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt her kan du endre når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko tutaj możesz zmienić w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo aqui é seu para mudar quando quiser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt här kan du ändra när som helst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的一切都可以随时更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的一切都可以隨時更改。"
          }
        }
      }
    },
    "You're Founding Member #%lld. Every look is yours.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er stiftende medlem #%lld. Alle looks er dine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Gründungsmitglied #%lld. Alle Looks gehören dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres miembro fundador #%lld. Todos los aspectos son tuyos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet perustajajäsen #%lld. Kaikki ulkoasut ovat sinun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes Membre fondateur #%lld. Tous les looks sont à vous."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú ert stofnfélagi #%lld. Öll útlitin eru þín."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei Membro fondatore #%lld. Ogni aspetto è tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは創設メンバー #%lld です。すべての見た目があなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창립 멤버 #%lld이(가) 되었습니다. 모든 외관이 내 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er stiftende medlem nr. %lld. Alle utseender er dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś Członkiem Założycielem #%lld. Każdy wygląd jest twój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é Membro Fundador #%lld. Todos os visuais são seus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är grundande medlem #%lld. Alla utseenden är dina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是创始成员 #%lld。所有外观都归你所有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是創始成員 #%lld。所有外觀都屬於你。"
          }
        }
      }
    },
