            "state": "translated",
            "value": "最近見た配信を消去しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 시청을 지울까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除最近观看？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除最近觀看？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar os assistidos recentemente?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyścić ostatnio oglądane?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd senest set?"
          }
        },
        "fi": {
          "stringUnit": {
