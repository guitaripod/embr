    "Studio closes on this Apple TV until you sign in again.": {
      "comment": "Studio sign out confirm",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio lukker på denne Apple TV, indtil du logger ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio schließt auf diesem Apple TV, bis du dich erneut anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio se cierra en este Apple TV hasta que vuelvas a iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio sulkeutuu tällä Apple TV:llä, kunnes kirjaudut uudelleen sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio se ferme sur cette Apple TV jusqu'à votre prochaine connexion."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio lokast á þessum Apple TV þar til þú skráir þig inn aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio si chiude su questa Apple TV finché non accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度サインインするまで、この Apple TV では Studio が閉じられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 로그인할 때까지 이 Apple TV에서 Studio가 닫혀요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio lukkes på denne Apple TV-en til du logger inn igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio zamyka się na tym Apple TV, dopóki znowu się nie zalogujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Studio fecha nesta Apple TV até você entrar novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio stängs på den här Apple TV:n tills du loggar in igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你重新登录之前，此 Apple TV 上的 Studio 将关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新登入前，此 Apple TV 上的 Studio 會關閉。"
          }
        }
      }
    },
    "Studio comes alive the moment you go live.": {
      "comment": "Studio offline",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio vågner op, så snart du går live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio erwacht, sobald du live gehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio cobra vida en cuanto empiezas el directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio herää eloon heti, kun menet Liveen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio s'anime dès que vous passez en direct."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio lifnar við um leið og þú ferð í beina útsendingu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio si attiva nel momento in cui vai in diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信を開始した瞬間に Studio が動き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송을 시작하는 순간 Studio가 살아나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio våkner så snart du går direkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio ożywa w chwili, gdy zaczniesz transmisję na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Studio ganha vida assim que você entra em live."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio vaknar till liv så snart du går live."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你一开播，Studio 就会开始运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一開播，Studio 就會開始運作。"
          }
        }
      }
    },
    "Studio needs your Twitch account to show your channel. Embr never sees your password.": {
      "comment": "Settings section",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio har brug for din Twitch-konto for at vise din kanal. Embr ser aldrig din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio braucht dein Twitch-Konto, um deinen Kanal anzuzeigen. Embr sieht dein Passwort nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio necesita tu cuenta de Twitch para mostrar tu canal. Embr nunca ve tu contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio tarvitsee Twitch-tilisi näyttääkseen kanavasi. Embr ei koskaan näe salasanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio a besoin de votre compte Twitch pour afficher votre chaîne. Embr ne voit jamais votre mot de passe."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio þarf Twitch-aðganginn þinn til að sýna rásina þína. Embr sér aldrei lykilorðið þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio ha bisogno del tuo account Twitch per mostrare il tuo canale. Embr non vede mai la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio がチャンネルを表示するには Twitch アカウントが必要です。Embr がパスワードを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio가 채널을 보여 주려면 Twitch 계정이 필요해요. Embr은 비밀번호를 보지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio trenger Twitch-kontoen din for å vise kanalen din. Embr ser aldri passordet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio potrzebuje twojego konta Twitch, aby pokazać kanał. Embr nigdy nie widzi twojego hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Studio precisa da sua conta da Twitch para mostrar o seu canal. O Embr nunca vê sua senha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio behöver ditt Twitch-konto för att visa din kanal. Embr ser aldrig ditt lösenord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio 需要你的 Twitch 账号来显示你的频道。Embr 永远不会看到你的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio 需要你的 Twitch 帳號才能顯示你的頻道。Embr 從不會看到你的密碼。"
          }
        }
      }
    },
    "Studio shows your own channel, or one you moderate. Permissions decide what Studio may read and do on Twitch.": {
      "comment": "Settings section",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio viser din egen kanal eller en, du modererer. Tilladelser bestemmer, hvad Studio må læse og gøre på Twitch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio zeigt deinen eigenen Kanal oder einen, den du moderierst. Berechtigungen legen fest, was Studio auf Twitch lesen und tun darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio muestra tu propio canal o uno que moderas. Los permisos deciden lo que Studio puede leer y hacer en Twitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio näyttää oman kanavasi tai kanavan, jota moderoit. Käyttöoikeudet määrittävät, mitä Studio saa lukea ja tehdä Twitchissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio affiche votre propre chaîne ou une chaîne que vous modérez. Les autorisations déterminent ce que Studio peut lire et faire sur Twitch."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio sýnir þína eigin rás eða rás sem þú hefur umsjón með. Heimildir ráða því hvað Studio má lesa og gera á Twitch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio mostra il tuo canale o un canale che moderi. Le autorizzazioni decidono cosa Studio può leggere e fare su Twitch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio は自分のチャンネル、またはモデレートしているチャンネルを表示します。権限によって、Studio が Twitch で読み取り・操作できる内容が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio는 내 채널이나 내가 관리하는 채널을 보여 줘요. 권한에 따라 Studio가 Twitch에서 읽고 할 수 있는 작업이 정해져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio viser din egen kanal, eller en du modererer. Tillatelsene bestemmer hva Studio kan lese og gjøre på Twitch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio pokazuje twój kanał lub kanał, który moderujesz. Uprawnienia decydują, co Studio może czytać i robić na Twitchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Studio mostra o seu canal ou um que você modera. As permissões definem o que o Studio pode ler e fazer na Twitch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio visar din egen kanal eller en du modererar. Behörigheterna avgör vad Studio får läsa och göra på Twitch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio 显示你自己的频道或你管理的频道。权限决定 Studio 可在 Twitch 上读取和执行哪些操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio 會顯示你自己的頻道，或你擔任版主的頻道。權限決定 Studio 可以在 Twitch 上讀取和執行的操作。"
          }
        }
      }
    },
