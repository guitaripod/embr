    "Change your theme, colors, chat font and badge any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift tema, farver, chatskrifttype og mærke når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere Erscheinungsbild, Farben, Chat-Schrift und Abzeichen jederzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tu tema, colores, fuente del chat e insignia cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vaihtaa teemaa, värejä, chatin fonttia ja merkkiä milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez votre thème, vos couleurs, la police du chat et votre badge à tout moment."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur breytt þema, litum, leturgerð spjalls og merki hvenær sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tema, colori, font della chat e badge quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、色、チャットフォント、バッジはいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 색상, 채팅 글꼴, 배지는 언제든지 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre tema, farger, chattens skrifttype og merke når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw, kolory, czcionkę czatu i odznakę zmienisz w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar o tema, as cores, a fonte do chat e o selo a qualquer momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra ditt tema, dina färger, chattens typsnitt och märke när som helst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时更改主题、颜色、聊天字体和徽章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時更改主題、顏色、聊天字體和徽章。"
          }
        }
      }
    },
    "One purchase: themes, colors, chat fonts and a flame badge everyone sees. Studio Pro is separate.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét køb: temaer, farver, chatskrifttyper og et flammemærke, som alle kan se. Studio Pro er separat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf: Designs, Farben, Chat-Schriften und ein Flammen-Abzeichen, das alle sehen. Studio Pro ist separat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra: temas, colores, tipografías del chat y una insignia de llama que todos ven. Studio Pro es aparte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi osto: teemat, värit, chatin fontit ja liekkimerkki, jonka kaikki näkevät. Studio Pro on erillinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat : thèmes, couleurs, polices du chat et un badge flamme visible de tous. Studio Pro est distinct."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kaup: þemu, litir, leturgerðir í spjalli og logamerki sem allir sjá. Studio Pro er sér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto: temi, colori, font della chat e un badge a fiamma visibile a tutti. Studio Pro è separato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、テーマ、カラー、チャットのフォント、誰からも見える炎のバッジが手に入ります。Studio Pro は別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 구매로 테마, 색상, 채팅 글꼴과 모두에게 보이는 불꽃 배지를 얻어요. Studio Pro는 별도예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kjøp: temaer, farger, chatteskrifter og et flammemerke som alle ser. Studio Pro er separat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup: motywy, kolory, czcionki czatu i odznaka z płomieniem widoczna dla wszystkich. Studio Pro to osobny zakup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra única: temas, cores, fontes do chat e um selo de chama que todos veem. O Studio Pro é separado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett enda köp: teman, färger, chattens typsnitt och ett flammärke som alla ser. Studio Pro är separat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买：主题、配色、聊天字体，以及所有人都能看到的火焰徽章。Studio Pro 需单独购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買：主題、顏色、聊天字型，以及大家都看得到的火焰徽章。Studio Pro 是另外的付費項目。"
          }
        }
      }
    },
    "Every Studio Pro feature is yours on iPhone, iPad and Apple TV.": {
      "comment": "Studio Pro settings",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Studio Pro-funktioner er dine på iPhone, iPad og Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Studio-Pro-Funktion gehört dir auf iPhone, iPad und Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones de Studio Pro son tuyas en iPhone, iPad y Apple TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki Studio Pro -ominaisuudet ovat käytössäsi iPhonella, iPadilla ja Apple TV:llä."
