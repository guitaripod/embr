    "Get Live Alerts?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Hinweise aktivieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les alertes de direct ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar avisos de directos?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare gli avvisi live?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ通知をオンにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 알림을 켤까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启直播提醒？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟直播提醒？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar alertas de transmissão ao vivo?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączyć powiadomienia o transmisjach?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du have live-notifikationer?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otetaanko live-ilmoitukset käyttöön?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kveikja á tilkynningum um beinar útsendingar?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få direktevarsler?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få livenotiser?"
          }
        }
      }
    },
    "Get a notification when a channel you follow goes live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Mitteilung, sobald ein Kanal, dem du folgst, live geht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification quand une chaîne que vous suivez passe en direct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación cuando un canal que sigues empiece a emitir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando un canale che segui va in diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー中のチャンネルが配信を始めたら通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우한 채널이 방송을 시작하면 알림을 받습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你关注的频道开播时，你会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你追蹤的頻道開播時，你會收到通知。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba uma notificação quando um canal que você segue entrar ao vivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz powiadomienie, gdy obserwowany kanał rozpocznie transmisję."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en notifikation, når en kanal, du følger, går live."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun seuraamasi kanava menee liveen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fáðu tilkynningu þegar rás sem þú fylgist með fer í beina útsendingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få et varsel når en kanal du følger går direkte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en notis när en kanal du följer går live."
