    "The sign-in was declined on Twitch. A new code is ready if you want to try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Loginforsøget blev afvist på Twitch. Der er en ny kode klar, hvis du vil prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde auf Twitch abgelehnt. Ein neuer Code ist bereit, falls du es noch einmal versuchen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch rechazó el inicio de sesión. Hay un código nuevo listo si quieres volver a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen hylättiin Twitchissä. Uusi koodi on valmis, jos haluat yrittää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été refusée sur Twitch. Un nouveau code est prêt si vous voulez réessayer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innskráningunni var hafnað á Twitch. Nýr kóði er tilbúinn ef þú vilt reyna aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è stato rifiutato su Twitch. Un nuovo codice è pronto se vuoi riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitchでサインインが拒否されました。もう一度試す場合は新しいコードを使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch에서 로그인이 거부되었습니다. 다시 시도하려면 새 코드를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingen ble avvist på Twitch. Det er en ny kode klar hvis du vil prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie zostało odrzucone na Twitch. Jeśli chcesz spróbować ponownie, nowy kod jest gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login foi recusado na Twitch. Um novo código está pronto se quiser tentar de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen nekades på Twitch. En ny kod är redo om du vill försöka igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 上的登录被拒绝。如需重试，新的代码已准备就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 上的登入被拒絕。如需重試，新的代碼已準備就緒。"
          }
        }
      }
    },
