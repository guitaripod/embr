    "Ad break. Tap to play Embr Flyer while the stream resumes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepause. Tippe, um Embr Flyer zu spielen, bis der Stream weitergeht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause publicitaire. Touchez pour jouer à Embr Flyer en attendant la reprise du stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa publicitaria. Toca para jugar a Embr Flyer mientras vuelve el stream."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa pubblicitaria. Tocca per giocare a Embr Flyer mentre lo stream riprende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告中です。配信が戻るまで Embr Flyer をプレイするにはタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 중입니다. 방송이 재개될 때까지 Embr Flyer를 플레이하려면 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告插播中。点按即可在直播恢复前玩 Embr Flyer。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告時段。點一下即可在直播恢復前玩 Embr Flyer。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo de anúncios. Toque para jogar Embr Flyer enquanto o stream volta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa na reklamę. Stuknij, aby zagrać w Embr Flyer, zanim stream wróci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamepause. Tryk for at spille Embr Flyer, mens streamen fortsætter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainostauko. Napauta toistaaksesi Embr Flyerin, kunnes striimi jatkuu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Auglýsingahlé. Pikkaðu til að spila Embr Flyer meðan streymið heldur áfram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamepause. Trykk for å spille Embr Flyer mens streamen fortsetter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonspaus. Tryck för att spela Embr Flyer medan streamen återupptas."
          }
        }
      }
    },
