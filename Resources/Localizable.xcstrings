    "The purchase finishes once it's approved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet gennemføres, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wird abgeschlossen, sobald er genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra se completa cuando se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto valmistuu, kun se on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat se termine une fois approuvé."
          }
        },
        "is": {
