          "stringUnit": {
            "state": "translated",
            "value": "Twitch non risponde. Studio continua a riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch から応答がありません。Studio は再試行を続けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 응답하지 않아요. Studio가 계속 시도하고 있어요."
          }
        },
        "pl": {
          "stringUnit": {
