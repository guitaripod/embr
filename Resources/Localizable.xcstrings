          }
        }
      }
    },
    "Twitch asks you to approve exactly the permissions you chose. Embr never sees your password.": {
      "comment": "Studio sign-in footnote",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch beder dig godkende præcis de tilladelser, du valgte. Embr ser aldrig din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bittet dich, genau die gewählten Berechtigungen zu bestätigen. Embr sieht dein Passwort nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch te pide que apruebes exactamente los permisos que elegiste. Embr nunca ve tu contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch pyytää sinua hyväksymään juuri valitsemasi käyttöoikeudet. Embr ei koskaan näe salasanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch vous demande d'approuver exactement les autorisations choisies. Embr ne voit jamais votre mot de passe."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch biður þig um að samþykkja nákvæmlega þær heimildir sem þú valdir. Embr sér aldrei lykilorðið þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ti chiede di approvare esattamente le autorizzazioni scelte. Embr non vede mai la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch から、選んだ権限だけを承認するよう求められます。Embr がパスワードを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 선택한 권한만 승인하도록 요청해요. Embr은 비밀번호를 보지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ber deg godkjenne akkurat de tillatelsene du valgte. Embr ser aldri passordet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch prosi o zatwierdzenie dokładnie wybranych uprawnień. Embr nigdy nie widzi twojego hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch pede que você aprove exatamente as permissões escolhidas. O Embr nunca vê sua senha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ber dig godkänna exakt de behörigheter du valde. Embr ser aldrig ditt lösenord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 会要求你确认所选的权限。Embr 永远不会看到你的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 會請你確認你選擇的權限。Embr 從不會看到你的密碼。"
          }
        }
      }
    },
