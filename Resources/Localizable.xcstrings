            "value": "Todo lo que diga esta persona destacará en el chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän henkilön viestit erottuvat chatissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que dit cette personne ressortira dans le chat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt sem þessi notandi segir verður áberandi í spjallinu."
