          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convém deixar esta TV onde você possa vê-la durante a transmissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
