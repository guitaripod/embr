    "Live playback is paused on Apple TV while Twitch changes how streams are delivered. Past broadcasts and clips still play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Wiedergabe auf Apple TV ist pausiert, während Twitch ändert, wie Streams ausgeliefert werden. Vergangene Übertragungen und Clips werden weiterhin abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción en directo en Apple TV está en pausa mientras Twitch cambia la forma de entregar los streams. Las emisiones pasadas y los clips siguen reproduciéndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture en direct est suspendue sur Apple TV le temps que Twitch modifie la diffusion des flux. Les diffusions passées et les clips restent lisibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione in diretta su Apple TV è in pausa mentre Twitch cambia il modo in cui distribuisce gli stream. Le trasmissioni passate e le clip continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitchが配信の仕組みを変更している間、Apple TVではライブ再生を一時停止しています。過去の配信とクリップは引き続き再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 스트림 전달 방식을 바꾸는 동안 Apple TV에서 라이브 재생이 일시 중지됩니다. 지난 방송과 클립은 계속 재생됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie na żywo na Apple TV jest wstrzymane, gdy Twitch zmienia sposób dostarczania transmisji. Archiwalne transmisje i klipy nadal działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução ao vivo está pausada na Apple TV enquanto a Twitch muda a forma de entregar as transmissões. Transmissões passadas e clipes continuam funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 更改直播传输方式期间，Apple TV 上暂停直播播放。往期直播和剪辑仍可播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 更改直播傳輸方式期間，Apple TV 上暫停直播播放。往期直播和剪輯仍可播放。"
          }
        }
      }
    },
