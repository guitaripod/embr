    "Everything this person says will stand out in chat.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad denne person skriver, fremhæves i chatten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was diese Person sagt, sticht im Chat hervor."
