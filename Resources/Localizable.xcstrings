    "Write your own in Embr on iPhone or iPad: Settings > Embr Studio > Quick Messages. They reach the Apple TV through iCloud.": {
      "comment": "Studio quick messages help",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine egne i Embr på iPhone eller iPad: Indstillinger > Embr Studio > Hurtigbeskeder. De når Apple TV via iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe deine eigenen in Embr auf iPhone oder iPad: Einstellungen > Embr Studio > Schnellnachrichten. Sie erreichen den Apple TV über iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe los tuyos en Embr en iPhone o iPad: Ajustes > Embr Studio > Mensajes rápidos. Llegan al Apple TV a través de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita omasi Embr-sovelluksessa iPhonella tai iPadilla: Asetukset > Embr Studio > Pikaviestit. Ne tulevat Apple TV:lle iCloudin kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez les vôtres dans Embr sur iPhone ou iPad : Réglages > Embr Studio > Messages rapides. Ils arrivent sur l'Apple TV via iCloud."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifaðu þín eigin í Embr á iPhone eða iPad: Stillingar > Embr Studio > Flýtiskilaboð. Þau berast á Apple TV í gegnum iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivili tu in Embr su iPhone o iPad: Impostazioni > Embr Studio > Messaggi rapidi. Arrivano su Apple TV tramite iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のメッセージは iPhone または iPad の Embr で作成してください：設定 > Embr Studio > クイックメッセージ。Apple TV には iCloud 経由で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad의 Embr에서 직접 작성하세요: 설정 > Embr Studio > 빠른 메시지. iCloud를 통해 Apple TV에도 전달돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine egne i Embr på iPhone eller iPad: Innstillinger > Embr Studio > Hurtigmeldinger. De når Apple TV-en via iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz własne w Embr na iPhonie lub iPadzie: Ustawienia > Embr Studio > Szybkie wiadomości. Docierają na Apple TV przez iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva as suas no Embr, no iPhone ou iPad: Ajustes > Embr Studio > Mensagens rápidas. Elas chegam à Apple TV pelo iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv egna i Embr på iPhone eller iPad: Inställningar > Embr Studio > Snabbmeddelanden. De når Apple TV via iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 iPad 上的 Embr 中编写你自己的快捷消息：设置 > Embr Studio > 快捷消息。它们会通过 iCloud 同步到 Apple TV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 或 iPad 上的 Embr 中撰寫你自己的訊息：設定 > Embr Studio > 快速訊息。訊息會透過 iCloud 同步到 Apple TV。"
          }
        }
      }
    },
