            "state": "translated",
            "value": "Danke. Symbole, Farben und dein Chat-Abzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Iconos, colores e insignia del chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Icônes, couleurs et badge dans le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Icone, colori e distintivo in chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。アイコン、カラー、チャットのバッジが使えるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
