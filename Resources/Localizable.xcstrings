    "Tips unlock nothing. They keep Embr going.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinkgelder schalten nichts frei. Sie halten Embr am Laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las propinas no desbloquean nada. Sirven para mantener Embr en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourboires ne débloquent rien. Ils font vivre Embr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mance non sbloccano nulla. Servono a tenere in vita Embr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップで機能が解放されることはありません。Embrの運営を支えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁으로 잠금 해제되는 기능은 없습니다. Embr 운영을 도와줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiwki niczego nie odblokowują. Pomagają utrzymać Embr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gorjetas não desbloqueiam nada. Elas mantêm o Embr funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打赏不会解锁任何功能，只为让 Embr 持续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打賞不會解鎖任何功能，只為讓 Embr 持續運作。"
          }
        }
      }
    },
