    "You're offline. Studio comes alive the moment you go live.": {
      "comment": "Studio iOS offline",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Studio vågner op, så snart du går live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Studio erwacht, sobald du live gehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás desconectado. Studio cobra vida en cuanto empiezas el directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet Offline-tilassa. Studio herää eloon heti, kun menet Liveen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Studio s'anime dès que vous passez en direct."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú ert ekki í beinni. Studio lifnar við um leið og þú ferð í beina útsendingu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Studio si attiva nel momento in cui vai in diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。配信を開始した瞬間に Studio が動き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이에요. 방송을 시작하는 순간 Studio가 살아나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Studio våkner så snart du går direkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Studio ożywa w chwili, gdy zaczniesz transmisję na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. O Studio ganha vida assim que você entra em live."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Studio vaknar till liv så snart du går live."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。你一开播，Studio 就会开始运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已離線。一開播，Studio 就會開始運作。"
          }
        }
      }
