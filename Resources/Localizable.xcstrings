          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta? Marque canais com a estrela para guardá-los em Favoritos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz konta? Oznacz kanały gwiazdką, aby zachować je w Ulubionych."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto? Markér kanaler med en stjerne for at gemme dem i Favoritter."
          }
        },
        "fi": {
