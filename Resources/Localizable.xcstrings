    "Even with Twitch Turbo or a channel sub — here's what's happening.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch mit Twitch Turbo oder einem Kanal-Abo — hier steht, warum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même avec Twitch Turbo ou un abonnement à la chaîne — voici pourquoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso con Twitch Turbo o una suscripción al canal: esto es lo que pasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche con Twitch Turbo o un abbonamento al canale: ecco cosa succede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch Turbo やチャンネルサブスクに入っていても表示される理由はこちら。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch Turbo나 채널 구독이 있어도 광고가 나오는 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使有 Twitch Turbo 或频道订阅——原因在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使有 Twitch Turbo 或頻道訂閱——原因在這裡。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com Twitch Turbo ou uma inscrição no canal — veja o que acontece."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet z Twitch Turbo albo subskrypcją kanału — oto co się dzieje."
          }
        }
      }
    },
    "Everyone watching in Embr sees your flame badge and name this way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sehen alle, die Embr nutzen, dein Flammen-Abzeichen und deinen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así verán tu insignia de llama y tu nombre todos los que usan Embr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous ceux qui regardent sur Embr voient ainsi votre badge flamme et votre nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi guarda su Embr vede così il tuo badge a forma di fiamma e il tuo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Embrで視聴するすべての人に、この見た目で炎のバッジと名前が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr를 시청하는 모든 사람에게 이런 모습으로 내 불꽃 배지와 이름이 보입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy oglądający w Embr widzi tak twoją odznakę płomienia i nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mundo assistindo no Embr vê seu selo de chama e seu nome assim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Embr 中观看的人都会以这种方式看到你的火焰徽章和昵称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Embr 中觀看的人都會以這種方式看到你的火焰徽章和名稱。"
          }
        }
      }
    },
