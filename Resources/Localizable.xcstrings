    "No muted keywords.\nTap + to hide any chat message containing a word or phrase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine stummgeschalteten Wörter.\nTippe auf +, um Chat-Nachrichten mit einem Wort oder einer Wendung auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot-clé masqué.\nTouchez + pour masquer les messages contenant un mot ou une expression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay palabras silenciadas.\nToca + para ocultar los mensajes que contengan una palabra o frase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna parola chiave silenziata.\nTocca + per nascondere i messaggi che contengono una parola o una frase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュート中のキーワードはありません。\n+ をタップすると、その単語やフレーズを含むメッセージを非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뮤트한 키워드가 없습니다.\n+를 눌러 특정 단어나 문구가 포함된 채팅 메시지를 숨기세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已屏蔽的关键词。\n点按 + 即可隐藏包含某个词语或短语的聊天消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已靜音的關鍵字。\n點一下 + 即可隱藏包含特定字詞或短句的聊天訊息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma palavra silenciada.\nToque em + para ocultar mensagens que contenham uma palavra ou frase."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wyciszonych słów.\nStuknij +, aby ukrywać wiadomości czatu zawierające dane słowo lub wyrażenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dæmpede ord.\nTryk på + for at skjule en chatbesked, der indeholder et ord eller udtryk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mykistettyjä sanoja.\nNapauta +-painiketta piilottaaksesi chat-viestit, joissa on jokin sana tai ilmaisu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin þögguð orð.\nPikkaðu á + til að fela spjallskilaboð sem innihalda orð eða orðasamband."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dempede ord.\nTrykk på + for å skjule chat-meldinger som inneholder et ord eller uttrykk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga tystade ord.\nTryck på + för att dölja ett chattmeddelande som innehåller ett ord eller en fras."
          }
        }
      }
    },
