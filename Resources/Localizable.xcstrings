    "Twitch asked to wait a moment. Try again shortly.": {
      "comment": "Studio error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch bat um einen Moment Geduld. Versuche es gleich noch einmal."
          }
        },
        "es": {
