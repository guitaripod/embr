            "state": "translated",
            "value": "Rensa nyligen sedda?"
          }
        }
      }
    },
    "This removes every channel from Recently Watched. Your favorites are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Kanäle aus „Zuletzt angesehen“ entfernt. Deine Favoriten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire toutes les chaînes des regardés récemment. Vos favoris ne sont pas modifiés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los canales de Vistos recientemente. Tus favoritos no se ven afectados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutti i canali da Guardati di recente. I preferiti non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最近見た配信」からすべてのチャンネルを削除します。お気に入りは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 시청에서 모든 채널을 삭제합니다. 즐겨찾기는 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从“最近观看”中移除所有频道。你的收藏不会受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從「最近觀看」移除所有頻道。你的收藏不會受影響。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove todos os canais dos assistidos recentemente. Seus favoritos não são alterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie kanały z „Ostatnio oglądane”. Ulubione pozostaną bez zmian."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle kanaler fra »Senest set«. Dine favoritter berøres ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kaikki kanavat äskettäin katsotuista. Suosikkeihisi tämä ei vaikuta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta fjarlægir allar rásir úr „Nýlega skoðað“. Eftirlæti þín haldast óbreytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle kanaler fra «Nylig sett». Favorittene dine påvirkes ikke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort alla kanaler från nyligen sedda. Dina favoriter påverkas inte."
          }
        }
      }
    },
