    "Ad break · stream resumes in %llds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepause · Stream geht in %lld s weiter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause pub · le stream reprend dans %lld s"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa publicitaria · el stream vuelve en %lld s"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa pubblicitaria · lo stream riprende tra %lld s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告中 · %lld秒後に配信へ戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 중 · %lld초 후 방송 재개"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告插播 · %lld 秒后恢复直播"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告時段 · %lld 秒後恢復直播"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo de anúncios · o stream volta em %lld s"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa na reklamę · stream wznowi się za %lld s"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamepause · streamen fortsætter om %lld s"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainostauko · striimi jatkuu %lld s kuluttua"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Auglýsingahlé · streymi heldur áfram eftir %lld sek."
          }
        },
        "nb": {
