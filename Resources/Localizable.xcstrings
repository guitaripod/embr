    "Your favorites stay. Following and chatting as you stop until you sign in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Favoriten bleiben erhalten. Das Folgen und Chatten als du endet, bis du dich wieder anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus favoritos se conservan. Seguir canales y chatear como tú se detienen hasta que vuelvas a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos favoris sont conservés. Le suivi des chaînes et le chat en votre nom s'arrêtent jusqu'à ce que vous vous reconnectiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi preferiti restano. Seguire canali e chattare a tuo nome si interrompe finché non accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはそのまま残ります。再度サインインするまで、フォローとあなたとしてのチャットは停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기는 그대로 유지됩니다. 다시 로그인할 때까지 팔로우와 내 계정으로의 채팅이 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ulubione zostaną. Obserwowanie i czatowanie jako ty zostaną wstrzymane, dopóki znów się nie zalogujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus favoritos são mantidos. Seguir canais e conversar como você ficam suspensos até você entrar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的收藏会保留。在你重新登录之前，关注和以你的身份聊天功能将停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的最愛會保留。在你重新登入之前，追蹤和以你的身分聊天功能將停止。"
          }
        }
      }
    },
