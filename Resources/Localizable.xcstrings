    "Snooze and run ad breaks, alert sounds, the stream recap, moderator mode and quick messages, on every device.": {
      "comment": "Studio Pro settings",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepausen verschieben und starten, Alarmtöne, die Stream-Zusammenfassung, Moderatormodus und Schnellnachrichten, auf allen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaza y lanza cortes publicitarios, sonidos de alerta, el resumen del directo, el modo moderador y los mensajes rápidos, en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter et lancer des pauses publicitaires, sons d'alerte, récapitulatif du live, mode modérateur et messages rapides, sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posticipa e avvia le pubblicità, suoni degli avvisi, riepilogo della diretta, modalità moderatore e messaggi rapidi, su ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CM ブレイクのスヌーズと放送、アラート音、配信の振り返り、モデレーターモード、クイックメッセージを、すべてのデバイスで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 광고 시간 미루기와 실행, 알림음, 방송 요약, 모더레이터 모드, 빠른 메시지를 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkładanie i uruchamianie przerw na reklamy, dźwięki alertów, podsumowanie transmisji, tryb moderatora i szybkie wiadomości na każdym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiar e exibir intervalos de anúncios, sons de alerta, o resumo da transmissão, o modo moderador e as mensagens rápidas, em todos os dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有设备上延后并播放广告插播，同时使用提醒音效、直播回顾、管理员模式和快捷消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每台裝置上延後及播放廣告插播、提示音、直播回顧、版主模式和快速訊息。"
          }
        }
      }
    },
