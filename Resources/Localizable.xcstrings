    "Counts only, kept on this TV for 24 hours.": {
      "comment": "Studio recap footnote",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tællinger, gemt på dette TV i 24 timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zahlen, 24 Stunden auf diesem Fernseher gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo recuentos, guardados en este televisor durante 24 horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain lukuja, säilytetään tällä televisiolla 24 tuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffres uniquement, conservés sur cette télé pendant 24 heures."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins tölur, geymdar á þessu sjónvarpi í 24 klukkustundir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo conteggi, conservati su questa TV per 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "件数のみ、このテレビに 24 時間保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수치만 이 TV에 24시간 보관돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tellinger, lagres på denne TV-en i 24 timer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko liczby, przechowywane na tym telewizorze przez 24 godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas contagens, mantidas nesta TV por 24 horas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast siffror, sparas på den här TV:n i 24 timmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计数据，在此电视上保留 24 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保存數字，在這台電視上保留 24 小時。"
          }
        }
      }
    },
    "Delete, time out, ban, pin, shout out, chat modes, Shield Mode and AutoMod": {
      "comment": "Studio permission detail",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet, giv timeout, udeluk, fastgør, shoutout, chattilstande, Shield-tilstand og AutoMod"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen, Timeout, Sperren, Anheften, Shoutout, Chat-Modi, Shield-Modus und AutoMod"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar, poner en tiempo de espera, banear, fijar, hacer un shoutout, modos del chat, Modo Escudo y AutoMod"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisto, aikalisä, porttikielto, kiinnitys, Shoutout, chat-tilat, Shield-tila ja AutoMod"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer, exclure, bannir, épingler, shoutout, modes du chat, Mode Bouclier et AutoMod"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyða, setja í tímabundið bann, banna, festa, Shoutout, spjallhamir, Shield-hamur og AutoMod"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare, silenziare, bannare, fissare, shout-out, modalità chat, Shield Mode e AutoMod"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除、タイムアウト、BAN、ピン留め、シャウトアウト、チャットモード、シールドモード、AutoMod"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제, 타임아웃, 차단, 고정, 샤우트아웃, 채팅 모드, Shield Mode, AutoMod"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett, gi timeout, utesteng, fest, gi Shoutout, chatt-modus, Shield-modus og AutoMod"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwanie wiadomości, timeout, ban, przypinanie, Shout-out, tryby czatu, Shield Mode i AutoMod"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir, dar timeout, banir, fixar, fazer shout out, modos do chat, Modo Escudo e AutoMod"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera, ge timeout, banna, fästa, ge shoutout, chattlägen, Shield-läge och AutoMod"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除、禁言、封禁、置顶、Shout Out、聊天模式、Shield Mode 和 AutoMod"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除、禁言、封禁、釘選、Shout Out、聊天室模式、Shield Mode 與 AutoMod"
          }
        }
      }
    },
    "Double-tap to pause or play. Swipe up with three fingers for the next clip.": {
      "comment": "VoiceOver hint in the clip feed",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttryk for at sætte på pause eller afspille. Stryg opad med tre fingre for det næste klip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen zum Pausieren oder Abspielen. Mit drei Fingern nach oben wischen für den nächsten Clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para pausar o reproducir. Desliza hacia arriba con tres dedos para ver el siguiente clip."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksoisnapauta keskeyttääksesi tai toistaaksesi. Pyyhkäise kolmella sormella ylös seuraavaan klippiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez deux fois pour mettre en pause ou lire. Balayez vers le haut avec trois doigts pour le clip suivant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvísmelltu til að gera hlé eða spila. Strjúktu upp með þremur fingrum fyrir næstu klippu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per mettere in pausa o riprodurre. Scorri verso l'alto con tre dita per la clip successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで一時停止・再生。3 本指で上にスワイプすると次のクリップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 일시정지 또는 재생. 세 손가락으로 위로 쓸어 넘기면 다음 클립이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk to ganger for å pause eller spille av. Sveip opp med tre fingre for neste klipp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwukrotnie stuknij, aby wstrzymać lub odtworzyć. Przesuń w górę trzema palcami, aby przejść do następnego klipu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para pausar ou reproduzir. Deslize para cima com três dedos para o próximo clipe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltryck för att pausa eller spela upp. Svep uppåt med tre fingrar för nästa klipp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下暂停或播放。用三指向上滑动切换到下一个片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點兩下即可暫停或播放。用三指向上滑動可看下一個精華片段。"
          }
        }
      }
    },
