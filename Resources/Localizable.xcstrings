    "Press and hold any stream and choose Add to Favorites. Channels you star in Embr on iPhone show up here too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Stream gedrückt und wähle „Zu Favoriten hinzufügen“. Kanäle, die du in Embr auf dem iPhone markierst, erscheinen hier ebenfalls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado cualquier stream y elige Añadir a favoritos. Los canales que marques en Embr en el iPhone también aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez enfoncé un flux et choisissez Ajouter aux favoris. Les chaînes que vous mettez en favori dans Embr sur iPhone apparaissent aussi ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto uno stream e scegli Aggiungi ai preferiti. Anche i canali che contrassegni con la stella in Embr su iPhone compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信を長押しして「お気に入りに追加」を選択します。iPhoneのEmbrで星を付けたチャンネルもここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림을 길게 누르고 즐겨찾기에 추가를 선택하세요. iPhone의 Embr에서 즐겨찾기한 채널도 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj dowolny strumień i wybierz Dodaj do ulubionych. Kanały, które oznaczysz w Embr na iPhonie, też pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado qualquer stream e escolha Adicionar aos favoritos. Os canais que você favoritar no Embr no iPhone também aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按任意直播，选择“添加到收藏”。你在 iPhone 版 Embr 中收藏的频道也会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按任意直播，選擇「加入最愛」。你在 iPhone 版 Embr 中加入最愛的頻道也會顯示在這裡。"
          }
        }
      }
    },
