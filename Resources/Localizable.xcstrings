    "Reported %@. Their messages are now hidden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gemeldet. Die Nachrichten werden jetzt ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ signalé. Ses messages sont désormais masqués."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has reportado a %@. Sus mensajes ahora están ocultos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segnalato. I suoi messaggi ora sono nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を報告しました。今後メッセージは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 신고했습니다. 이제 해당 사용자의 메시지는 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已举报 %@。该用户的消息将不再显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢舉 %@。對方的訊息將不再顯示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ denunciado. As mensagens dele agora estão ocultas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszono %@. Wiadomości tej osoby są teraz ukryte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldt %@. Deres beskeder er nu skjult."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ilmiannettu. Hänen viestinsä on nyt piilotettu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkynnt: %@. Skilaboð þeirra eru nú falin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er rapportert. Meldingene deres er nå skjult."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har anmälts. Deras meddelanden döljs nu."
          }
        }
      }
    },
    "Reports are reviewed and this user will be hidden from your chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen werden geprüft, und dieser Nutzer wird in deinem Chat ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont examinés et cet utilisateur sera masqué de votre chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los reportes se revisan y este usuario quedará oculto en tu chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni vengono esaminate e questo utente verrà nascosto dalla tua chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告は確認され、このユーザーはあなたのチャットで非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고 내용은 검토되며, 이 사용자는 회원님의 채팅에서 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报会经过审核，该用户将在你的聊天中被隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢舉會經過審核，這位使用者也會從你的聊天室中隱藏。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias são analisadas e este usuário ficará oculto no seu chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenia są sprawdzane, a ten użytkownik zniknie z twojego czatu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser gennemgås, og denne bruger skjules i din chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmiannot tarkistetaan, ja tämä käyttäjä piilotetaan chatistasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkynningar eru yfirfarnar og þessi notandi verður falinn í spjallinu þínu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter blir gjennomgått, og denne brukeren skjules i chatten din."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmälningar granskas och användaren döljs från din chatt."
          }
        }
      }
    },
