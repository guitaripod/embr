            "value": "Du modererar ingen annan kanal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有管理其他任何频道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你沒有擔任版主的其他頻道。"
          }
        }
      }
    },
    "You went offline at %@. If that wasn't you, check your streaming software.": {
      "comment": "Studio offline, the stream ended",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gik offline kl. %@. Hvis det ikke var dig, så tjek din streamingsoftware."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist um %@ offline gegangen. Falls das nicht du warst, prüfe deine Streaming-Software."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te has desconectado a las %@. Si no fuiste tú, revisa tu software de streaming."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menit Offline-tilaan klo %@. Jos et itse tehnyt sitä, tarkista striimausohjelmasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes passé hors ligne à %@. Si ce n'était pas vous, vérifiez votre logiciel de streaming."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hættir í beinni útsendingu klukkan %@. Ef það varst ekki þú skaltu athuga streymishugbúnaðinn þinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei andato offline alle %@. Se non sei stato tu, controlla il tuo software di streaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にオフラインになりました。心当たりがない場合は、配信ソフトを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 오프라인이 되었어요. 본인이 아니라면 방송 소프트웨어를 확인해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gikk offline klokken %@. Hvis det ikke var deg, kontroller streamingprogrammet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmisja zakończyła się o %@. Jeśli to nie ty, sprawdź swoje oprogramowanie do streamingu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ficou offline às %@. Se não foi você, verifique seu software de transmissão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gick offline kl. %@. Om det inte var du, kontrollera din streamingprogramvara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你于 %@ 下播。如果不是你操作的，请检查你的直播软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你於 %@ 離線。如果不是你操作的，請檢查你的直播軟體。"
          }
        }
      }
    },
    "You'll want this TV where you can see it while you stream.": {
      "comment": "Studio welcome note",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil dette fjernsyn der, hvor du kan se det, mens du streamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle diesen Fernseher dort auf, wo du ihn beim Streamen sehen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene que tengas este televisor a la vista mientras haces directos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta tämä televisio paikkaan, josta näet sen striimatessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez cette télé là où vous pourrez la voir pendant vos lives."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú vilt hafa þetta sjónvarp þar sem þú sérð það meðan þú streymir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti conviene tenere questa TV dove puoi vederla mentre trasmetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信中に見えるよう、このテレビを置いておくと便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송하는 동안 잘 보이는 곳에 이 TV를 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser TV-en der du kan se den mens du streamer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telewizor powinien stać tam, gdzie widzisz go podczas transmisji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convém deixar esta TV onde você possa vê-la durante a transmissão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vill ha den här TV:n där du kan se den medan du streamar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直播时，你最好能看到这台电视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直播時，最好把這台電視放在你看得到的地方。"
          }
        }
      }
    },
