          }
        }
      }
    },
    "Twitch isn't answering. Studio keeps trying.": {
      "comment": "Studio status line",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch antwortet nicht. Studio versucht es weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch no responde. Studio sigue intentándolo."
          }
        },
        "fr": {
          "stringUnit": {
