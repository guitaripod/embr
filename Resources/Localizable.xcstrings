    "Join %lld Founding Members. One purchase, yours on every device with your Apple Account.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv en af %lld stiftende medlemmer. Ét køb, der er dit på alle enheder med din Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde eines von %lld Gründungsmitgliedern. Ein Kauf, auf jedem Gerät mit deinem Apple-Account nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a %lld miembros fundadores. Una sola compra, tuya en todos tus dispositivos con tu cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liity %lld perustajajäsenen joukkoon. Yksi osto, joka on käytettävissäsi kaikilla laitteillasi Apple-tilisi kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez %lld Membres fondateurs. Un seul achat, à vous sur tous vos appareils avec votre compte Apple."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertu með %lld stofnfélögum. Eitt kaup, þitt á hverju tæki með Apple-aðgangi þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a %lld Membri fondatori. Un solo acquisto, tuo su tutti i dispositivi con il tuo Account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld人の創設メンバーに加わりましょう。一度の購入で、同じApple アカウントのすべてのデバイスで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld명의 창립 멤버와 함께하세요. 한 번만 구매하면 Apple 계정으로 로그인한 모든 기기에서 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli en av %lld stiftende medlemmer. Ett kjøp, ditt på alle enheter med Apple-kontoen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do %lld Członków Założycieli. Jeden zakup, dostępny na każdym urządzeniu z kontem Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a %lld Membros Fundadores. Uma compra, sua em todos os dispositivos com sua Conta Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå med bland %lld grundande medlemmar. Ett enda köp som gäller på alla enheter med ditt Apple-konto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 位创始成员加入。一次购买，使用你的 Apple 账户即可在每台设备上使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有 %lld 位創始成員加入。一次購買，使用你的 Apple 帳號即可在每台裝置上使用。"
          }
        }
      }
    },
    "This Apple Account hasn't bought Founding Member yet.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Apple-konto har ikke købt Stiftende medlem endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account hat Gründungsmitglied noch nicht gekauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Apple Account aún no ha comprado Miembro fundador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Apple-tili ei ole vielä ostanut Perustajajäsen-tasoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
