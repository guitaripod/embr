    "Run your stream from anywhere in the room.": {
      "comment": "Paywall title, iPhone",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr din stream fra hvor som helst i rummet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere deinen Stream von überall im Raum aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona tu directo desde cualquier punto de la habitación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa striimiäsi mistä tahansa huoneessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez votre live depuis n'importe où dans la pièce."
          }
