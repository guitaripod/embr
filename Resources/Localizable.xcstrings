    "No settings match “%@”.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen indstillinger matcher »%@«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Einstellungen für „%@“ gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún ajuste coincide con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään asetus ei vastaa hakua ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun réglage ne correspond à « %@ »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engar stillingar passa við „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna impostazione corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致する設定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”과(와) 일치하는 설정이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen innstillinger samsvarer med «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ustawień pasujących do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ajuste corresponde a “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga inställningar matchar ”%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与“%@”匹配的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有與「%@」相符的設定。"
          }
        }
      }
    },
    "Signs you out, revokes Embr's access to your Twitch account and erases everything Embr keeps on this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger dig ud, tilbagekalder Embrs adgang til din Twitch-konto og sletter alt, hvad Embr gemmer på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich ab, widerruft den Zugriff von Embr auf dein Twitch-Konto und löscht alles, was Embr auf diesem Gerät speichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra tu sesión, revoca el acceso de Embr a tu cuenta de Twitch y borra todo lo que Embr guarda en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa sinut ulos, peruuttaa Embrin pääsyn Twitch-tilillesi ja poistaa kaiken, minkä Embr tallentaa tälle laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte, révoque l’accès d’Embr à votre compte Twitch et efface tout ce qu’Embr conserve sur cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráir þig út, afturkallar aðgang Embr að Twitch-aðganginum þínum og eyðir öllu sem Embr geymir á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti disconnette, revoca l’accesso di Embr al tuo account Twitch e cancella tutto ciò che Embr conserva su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトし、EmbrのTwitchアカウントへのアクセスを取り消して、このデバイスにEmbrが保存しているすべてのデータを消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하고, Embr의 Twitch 계정 접근 권한을 취소하며, 이 기기에 Embr이 저장한 모든 데이터를 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger deg av, trekker tilbake Embrs tilgang til Twitch-kontoen din og sletter alt Embr lagrer på denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowuje cię, cofa dostęp Embr do konta Twitch i usuwa wszystko, co Embr przechowuje na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta você, revoga o acesso do Embr à sua conta da Twitch e apaga tudo o que o Embr guarda neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggar ut dig, återkallar Embrs åtkomst till ditt Twitch-konto och raderar allt Embr sparar på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你登出，撤销 Embr 对你 Twitch 账户的访问权限，并清除 Embr 在此设备上保存的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你登出、撤銷 Embr 對你 Twitch 帳號的存取權限，並清除 Embr 在此裝置上保存的所有內容。"
          }
        }
