    "Run Ad uses the length you pick here first. Announcing posts your first quick message a minute before a scheduled break.": {
      "comment": "Settings section",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung schalten verwendet zuerst die Länge, die du hier wählst. Mit Ankündigung wird deine erste Schnellnachricht eine Minute vor einer geplanten Pause gepostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanzar anuncio usa primero la duración que elijas aquí. Anunciar publica tu primer mensaje rápido un minuto antes de un corte programado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer une pub utilise d'abord la durée choisie ici. L'annonce publie votre premier message rapide une minute avant une pause prévue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia pubblicità usa prima la durata scelta qui. Annunciare pubblica il primo messaggio rapido un minuto prima di una pausa programmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CM の放送は、ここで選んだ長さを最初に使います。お知らせをオンにすると、予定された CM ブレイクの 1 分前に最初のクイックメッセージを投稿します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 실행은 여기서 고른 길이를 먼저 사용해요. 안내를 켜면 예정된 광고 1분 전에 첫 빠른 메시지가 올라가요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomienie reklamy najpierw używa długości wybranej tutaj. Ogłaszanie publikuje pierwszą szybką wiadomość minutę przed zaplanowaną przerwą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibir anúncio usa primeiro a duração escolhida aqui. Anunciar publica sua primeira mensagem rápida um minuto antes de um intervalo agendado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“播放广告”会优先使用你在此处选择的时长。开启预告后，会在预定插播前一分钟发送你的第一条快捷消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「播放廣告」會先使用你在此選擇的長度。開啟公告後，會在排定插播前一分鐘發送第一則快速訊息。"
          }
        }
      }
    },
