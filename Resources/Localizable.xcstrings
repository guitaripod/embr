    "No account needed: tap the star on any channel to keep it in Favorites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto nötig: Tippe bei einem Kanal auf den Stern, um ihn in den Favoriten zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte requis : touchez l'étoile d'une chaîne pour la garder dans Favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta cuenta: toca la estrella de un canal para guardarlo en Favoritos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve un account: tocca la stella su un canale per tenerlo tra i Preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。チャンネルのスターをタップすると、お気に入りに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요하지 않습니다. 채널의 별표를 탭하면 즐겨찾기에 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号：点按任意频道上的星标，即可收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要帳號：點一下任何頻道上的星號，即可加入我的最愛。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é preciso ter conta: toque na estrela de um canal para guardá-lo em Favoritos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nie jest wymagane: stuknij gwiazdkę przy kanale, aby zachować go w Ulubionych."
          }
        }
      }
    },
    "No account? Star channels to keep them in Favorites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto? Markiere Kanäle mit dem Stern, um sie in den Favoriten zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte ? Ajoutez des chaînes avec l'étoile pour les garder dans Favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin cuenta? Marca canales con la estrella para guardarlos en Favoritos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai un account? Tocca la stella su un canale per tenerlo tra i Preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしでも、スターを付けたチャンネルはお気に入りに残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 없나요? 채널에 별표를 달면 즐겨찾기에 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账号？给频道加星标，即可收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號？替頻道加上星號，即可加入我的最愛。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta? Marque canais com a estrela para guardá-los em Favoritos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz konta? Oznacz kanały gwiazdką, aby zachować je w Ulubionych."
          }
        }
      }
    },
    "No blocked users.\nBlock someone from a chat message to hide them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine blockierten Nutzer.\nBlockiere jemanden über eine Chat-Nachricht, um ihn auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun utilisateur bloqué.\nBloquez quelqu'un depuis un message du chat pour le masquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay usuarios bloqueados.\nBloquea a alguien desde un mensaje del chat para ocultarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun utente bloccato.\nBlocca qualcuno da un messaggio in chat per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしたユーザーはいません。\nチャットのメッセージからブロックすると非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 사용자가 없습니다.\n채팅 메시지에서 차단하면 해당 사용자가 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已屏蔽的用户。\n在聊天消息上屏蔽某人即可隐藏其消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已封鎖的使用者。\n在聊天訊息上封鎖某人即可隱藏對方。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum usuário bloqueado.\nBloqueie alguém a partir de uma mensagem do chat para ocultá-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zablokowanych użytkowników.\nZablokuj kogoś z poziomu wiadomości czatu, aby go ukryć."
          }
        }
      }
    },
