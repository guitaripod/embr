            "value": "Twitch 未允许此操作。请在“设置”中检查 Studio 的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 不允許此操作。請在「設定」中檢查 Studio 的權限。"
          }
        }
      }
    },
    "Twitch isn't answering. Studio keeps trying.": {
      "comment": "Studio status line",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch svarer ikke. Studio prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch antwortet nicht. Studio versucht es weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch no responde. Studio sigue intentándolo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ei vastaa. Studio yrittää edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ne répond pas. Studio continue d'essayer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch svarar ekki. Studio heldur áfram að reyna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch non risponde. Studio continua a riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch から応答がありません。Studio は再試行を続けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 응답하지 않아요. Studio가 계속 시도하고 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch svarer ikke. Studio prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch nie odpowiada. Studio nadal próbuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch não está respondendo. O Studio continua tentando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch svarar inte. Studio fortsätter att försöka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 没有响应，Studio 会持续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 沒有回應。Studio 會持續嘗試。"
          }
        }
      }
    },
    "Twitch shows you exactly these permissions to approve. Chat is always on: Studio is built around it.": {
      "comment": "Studio permissions footer",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch viser præcis de tilladelser, du skal godkende. Chatten er altid aktiv: Studio er bygget op omkring den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch zeigt dir genau diese Berechtigungen zur Bestätigung. Der Chat ist immer aktiv: Studio ist darauf aufgebaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch te muestra exactamente estos permisos para aprobar. El chat siempre está activado: Studio gira en torno a él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch näyttää sinulle tarkalleen nämä käyttöoikeudet hyväksyttäviksi. Chat on aina käytössä: Studio on rakennettu sen ympärille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch vous montre exactement ces autorisations à approuver. Le chat est toujours activé : Studio est conçu autour de lui."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch sýnir þér nákvæmlega þessar heimildir til samþykkis. Spjall er alltaf virkt: Studio er byggt í kringum það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ti mostra esattamente queste autorizzazioni da approvare. La chat è sempre attiva: Studio è costruito attorno a essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch に承認を求める権限は、ここに表示されたものだけです。チャットは常にオンです。Studio はチャットを中心に作られています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 승인할 권한을 정확히 보여 줘요. 채팅은 항상 켜져 있어요. Studio는 채팅을 중심으로 만들어졌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch viser deg nøyaktig disse tillatelsene før du godkjenner. Chat er alltid på: Studio er bygget rundt den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch pokazuje dokładnie te uprawnienia do zatwierdzenia. Czat jest zawsze włączony: Studio jest wokół niego zbudowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch mostra exatamente estas permissões para você aprovar. O chat está sempre ativo: o Studio é construído em torno dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch visar dig exakt dessa behörigheter att godkänna. Chatten är alltid på: Studio är byggd kring den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 会向你展示需要确认的这些权限。聊天始终开启，Studio 正是围绕聊天而设计的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 會顯示你要確認的確切權限。聊天室一律開啟：Studio 就是以它為核心打造的。"
          }
        }
      }
    },
