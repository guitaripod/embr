    "Up to %lld. The first one is what an ad break announcement posts. Without Studio Pro, only the first one can be sent.": {
      "comment": "Studio quick messages footer",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %lld. Den første er den, der postes, når en reklamepause annonceres. Uden Studio Pro kan kun den første sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld. Die erste wird bei einer Werbepausen-Ankündigung gepostet. Ohne Studio Pro kann nur die erste gesendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld. El primero es el que publica el anuncio de un corte publicitario. Sin Studio Pro, solo se puede enviar el primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %lld. Ensimmäinen julkaistaan mainostauon ilmoituksena. Ilman Studio Pro -ominaisuutta voidaan lähettää vain ensimmäinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %lld. Le premier est celui publié lors de l'annonce d'une pause publicitaire. Sans Studio Pro, seul le premier peut être envoyé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt að %lld. Sú fyrsta er það sem tilkynning um auglýsingahlé birtir. Án Studio Pro er aðeins hægt að senda þá fyrstu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %lld. Il primo è quello che pubblica un annuncio di pubblicità. Senza Studio Pro, si può inviare solo il primo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 %lld 件。最初の 1 件が CM ブレイクのお知らせとして投稿されます。Studio Pro がない場合は、最初の 1 件のみ送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개. 첫 번째 메시지는 광고 시간 안내로 올라가요. Studio Pro가 없으면 첫 번째 메시지만 보낼 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %lld. Den første er meldingen som legges ut når en reklamepause kunngjøres. Uten Studio Pro kan bare den første sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %lld. Pierwsza to wiadomość, którą publikuje ogłoszenie przerwy na reklamy. Bez Studio Pro można wysłać tylko pierwszą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %lld. A primeira é a que o aviso de intervalo de anúncios publica. Sem o Studio Pro, só a primeira pode ser enviada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %lld. Den första postas när en annonspaus meddelas. Utan Studio Pro kan bara den första skickas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 条。第一条是广告插播预告时发送的内容。没有 Studio Pro 时，只能发送第一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 則。第一則會是廣告插播公告的內容。未購買 Studio Pro 時，僅能發送第一則。"
          }
        }
      }
    },
