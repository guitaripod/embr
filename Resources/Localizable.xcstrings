        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in attesa. I messaggi trattenuti compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のものはありません。保留されたメッセージがここに表示されます。"
