        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les messages envoyés juste avant votre arrivée, chargés depuis recent-messages.robotty.de."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i messaggi inviati poco prima del tuo arrivo, caricati da recent-messages.robotty.de."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加する直前に送信されたメッセージを recent-messages.robotty.de から読み込んで表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여하기 직전에 전송된 메시지를 recent-messages.robotty.de에서 불러와 보여줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wiadomości wysłane tuż przed dołączeniem, wczytane z recent-messages.robotty.de."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as mensagens enviadas logo antes de você entrar, carregadas de recent-messages.robotty.de."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你加入前不久发送的消息，数据来自 recent-messages.robotty.de。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你加入前不久傳送的訊息，資料來自 recent-messages.robotty.de。"
          }
        }
      }
    },
    "Background Audio keeps a stream playing when you leave Embr or lock your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio im Hintergrund hält einen Stream am Laufen, wenn du Embr verlässt oder dein iPhone sperrst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio en segundo plano mantiene la reproducción de un stream cuando sales de Embr o bloqueas tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio en arrière-plan poursuit la lecture d’un stream lorsque vous quittez Embr ou verrouillez votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio in background mantiene la riproduzione di uno stream quando esci da Embr o blocchi il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Embrを離れたり、iPhoneをロックしたりしても、配信の再生を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr을 나가거나 iPhone을 잠가도 스트림 재생을 계속합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk w tle utrzymuje odtwarzanie streamu, gdy opuścisz Embr lub zablokujesz iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Áudio em segundo plano mantém um stream em reprodução quando você sai do Embr ou bloqueia seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开 Embr 或锁定 iPhone 后，后台音频会继续播放直播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開 Embr 或鎖定 iPhone 後，背景音訊會繼續播放直播。"
          }
        }
      }
    },
