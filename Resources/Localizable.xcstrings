    "No favorites are live right now. Tap the star on a channel to add it here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Favoriten sind gerade live. Tippe auf den Stern eines Kanals, um ihn hier hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun favori n'est en direct. Touchez l'étoile d'une chaîne pour l'ajouter ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún favorito está en directo ahora. Toca la estrella de un canal para añadirlo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun preferito è in diretta ora. Tocca la stella di un canale per aggiungerlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの配信は今はありません。チャンネルの星をタップするとここに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 라이브 중인 즐겨찾기가 없습니다. 채널의 별을 눌러 여기에 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏的频道目前没有直播。点按频道的星标即可添加到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏的頻道目前沒有直播。點按頻道的星號即可加入這裡。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum favorito está ao vivo agora. Toque na estrela de um canal para adicioná-lo aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden ulubiony kanał nie jest teraz na żywo. Dotknij gwiazdki kanału, aby dodać go tutaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen favoritter er live lige nu. Tryk på stjernen ved en kanal for at tilføje den her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksikään suosikeistasi ei ole juuri nyt live. Lisää kanava tänne napauttamalla sen tähteä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin eftirlæti eru í beinni eins og er. Pikkaðu á stjörnuna á rás til að bæta henni hér við."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen favoritter er direkte akkurat nå. Trykk på stjernen på en kanal for å legge den til her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga favoriter är live just nu. Tryck på stjärnan på en kanal för att lägga till den här."
          }
        }
      }
    },
