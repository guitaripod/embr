    "Objectionable messages are hidden. Users you block are hidden from your chat and reported to the developer.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stødende beskeder skjules. Brugere, du blokerer, skjules i din chat og anmeldes til udvikleren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstößige Nachrichten werden ausgeblendet. Nutzer, die du blockierst, werden in deinem Chat ausgeblendet und dem Entwickler gemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes ofensivos se ocultan. Los usuarios que bloqueas se ocultan de tu chat y se notifican al desarrollador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiattomat viestit piilotetaan. Estämäsi käyttäjät piilotetaan chatistasi, ja heistä ilmoitetaan kehittäjälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages choquants sont masqués. Les utilisateurs que vous bloquez sont masqués dans votre chat et signalés au développeur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Móðgandi skilaboð eru falin. Notendur sem þú lokar á eru faldir í spjallinu þínu og tilkynntir þróunaraðilanum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi offensivi sono nascosti. Gli utenti che blocchi sono nascosti dalla tua chat e segnalati allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不快なメッセージは非表示になります。ブロックしたユーザーはチャットから非表示になり、開発者に報告されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불쾌한 메시지는 숨겨집니다. 차단한 사용자는 내 채팅에서 숨겨지고 개발자에게 신고됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Støtende meldinger skjules. Brukere du blokkerer, skjules i chatten din og rapporteres til utvikleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraźliwe wiadomości są ukrywane. Użytkownicy, których blokujesz, są ukrywani na twoim czacie i zgłaszani twórcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens ofensivas são ocultadas. Usuários que você bloqueia ficam ocultos no seu chat e são denunciados ao desenvolvedor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stötande meddelanden döljs. Användare du blockerar döljs i din chatt och anmäls till utvecklaren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令人反感的消息会被隐藏。你屏蔽的用户会在你的聊天中被隐藏，并会向开发者举报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "令人反感的訊息會被隱藏。你封鎖的使用者會在你的聊天中被隱藏，並會向開發者檢舉。"
          }
        }
      }
    },
