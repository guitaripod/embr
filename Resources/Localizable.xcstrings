    "Make Embr Yours": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør Embr til din egen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach Embr zu deinem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz Embr tuyo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee Embristä omasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites d'Embr le vôtre"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerðu Embr að þínu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi Embr tuo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Embrを自分好みに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Embr를 내 스타일로"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør Embr til ditt eget"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządź Embr po swojemu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o Embr com a sua cara"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör Embr till ditt eget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Embr 更有你的风格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Embr 更有你的風格"
          }
        }
      }
    },
    "Themes, accent colors, chat fonts, app icons and a flame badge everyone in Embr sees beside your name, with a founding number that stays yours. Try them on below; watching never needs any of it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer, accentfarver, chatskrifttyper, app-ikoner og et flammemærke, som alle i Embr ser ved siden af dit navn, med et stifternummer, der forbliver dit. Prøv dem nedenfor; at se med kræver aldrig noget af det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Designs, Akzentfarben, Chat-Schriften, App-Symbole und ein Flammen-Abzeichen, das alle in Embr neben deinem Namen sehen, mit einer Gründungsnummer, die dir bleibt. Probiere sie unten aus; zum Zuschauen braucht man davon nie etwas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, colores de acento, fuentes del chat, iconos de app y una insignia de llama que todos en Embr ven junto a tu nombre, con un número de fundador que es tuyo para siempre. Pruébalos abajo; mirar nunca necesita nada de esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemat, korostusvärit, chatin fontit, sovelluskuvakkeet ja liekkimerkki, jonka kaikki Embrissä näkevät nimesi vieressä, sekä perustajanumero, joka pysyy sinulla. Kokeile niitä alla; katsominen ei vaadi tästä mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thèmes, couleurs d'accent, polices du chat, icônes d'app et un badge flamme que tout le monde voit à côté de votre nom dans Embr, avec un numéro de fondateur qui reste le vôtre. Essayez-les ci-dessous : regarder n'a jamais besoin de rien de tout cela."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þemu, áherslulitir, leturgerðir spjalls, app-tákn og logamerki sem allir í Embr sjá við hliðina á nafninu þínu, með stofnunarnúmeri sem helst þitt. Prófaðu þau hér fyrir neðan; áhorf krefst aldrei neins af þessu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temi, colori di accento, font della chat, icone dell'app e un badge a fiamma che tutti in Embr vedono accanto al tuo nome, con un numero di fondatore che resta tuo. Provali qui sotto: guardare non richiede nulla di tutto questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、アクセントカラー、チャットフォント、Appアイコン、そしてEmbrのみんなに名前の横で見える炎のバッジと、ずっとあなたのものになる創設番号。下で試してみてください。視聴にこれらは一切必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 강조 색상, 채팅 글꼴, 앱 아이콘, 그리고 Embr의 모든 사람이 내 이름 옆에서 보는 불꽃 배지와 계속 내 것으로 남는 창립 번호. 아래에서 미리 적용해 보세요. 시청에는 이 중 어떤 것도 필요하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer, aksentfarger, skrifttyper i chatten, app-ikoner og et flammemerke som alle i Embr ser ved siden av navnet ditt, med et stifternummer som forblir ditt. Prøv dem nedenfor; å se på streams krever aldri noe av dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywy, kolory akcentu, czcionki czatu, ikony aplikacji i odznaka płomienia, którą wszyscy w Embr widzą obok twojej nazwy, z numerem założycielskim, który zostaje przy tobie. Wypróbuj je poniżej. Oglądanie nigdy niczego z tego nie wymaga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, cores de destaque, fontes do chat, ícones do app e um selo de chama que todo mundo no Embr vê ao lado do seu nome, com um número de fundador que fica com você. Experimente abaixo; assistir nunca exige nada disso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman, accentfärger, chattens typsnitt, appikoner och ett flammärke som alla i Embr ser bredvid ditt namn, med ett grundarnummer som förblir ditt. Prova dem nedan; för att titta behövs aldrig något av det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、强调色、聊天字体、App 图标，以及 Embr 中所有人都能在你名字旁看到的火焰徽章，还有永久归你所有的创始编号。可以在下方试用；观看从来不需要这些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題、強調色、聊天字體、App 圖示，以及 Embr 中所有人都能在你名字旁看到的火焰徽章，還有永久屬於你的創始編號。可以在下方試用；觀看從來不需要這些。"
          }
        }
      }
    },
    "Themes, accent colors, chat fonts and a flame badge everyone in Embr sees beside your name, with a founding number that stays yours. Try them on below; Studio never needs any of it.": {
      "localizations": {
        "da": {
