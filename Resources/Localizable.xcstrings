    "Everything this person says will stand out in chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was diese Person sagt, sticht im Chat hervor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que diga esta persona destacará en el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que dit cette personne ressortira dans le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che scrive questa persona risalterà in chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人の発言はすべてチャットで目立つように表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자의 모든 메시지가 채팅에서 돋보이게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co napisze ta osoba, będzie wyróżnione na czacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que essa pessoa disser vai se destacar no chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户的所有发言都会在聊天中突出显示。"
