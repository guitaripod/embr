    "This clip can't be played right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Clip lässt sich gerade nicht abspielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce clip ne peut pas être lu pour le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este clip no se puede reproducir ahora mismo."
          }
        },
        "it": {
