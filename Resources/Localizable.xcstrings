          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 没有响应，Studio 会持续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 沒有回應。Studio 會持續嘗試。"
          }
        }
      }
    },
    "Twitch shows you exactly these permissions to approve. Chat is always on: Studio is built around it.": {
      "comment": "Studio permissions footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch zeigt dir genau diese Berechtigungen zur Bestätigung. Der Chat ist immer aktiv: Studio ist darauf aufgebaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch te muestra exactamente estos permisos para aprobar. El chat siempre está activado: Studio gira en torno a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch vous montre exactement ces autorisations à approuver. Le chat est toujours activé : Studio est conçu autour de lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch ti mostra esattamente queste autorizzazioni da approvare. La chat è sempre attiva: Studio è costruito attorno a essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch に承認を求める権限は、ここに表示されたものだけです。チャットは常にオンです。Studio はチャットを中心に作られています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch가 승인할 권한을 정확히 보여 줘요. 채팅은 항상 켜져 있어요. Studio는 채팅을 중심으로 만들어졌어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch pokazuje dokładnie te uprawnienia do zatwierdzenia. Czat jest zawsze włączony: Studio jest wokół niego zbudowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twitch mostra exatamente estas permissões para você aprovar. O chat está sempre ativo: o Studio é construído em torno dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 会向你展示需要确认的这些权限。聊天始终开启，Studio 正是围绕聊天而设计的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
