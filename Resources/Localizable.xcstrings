    "Could not connect your Twitch account. You can continue as a guest and sign in later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Twitch-Konto konnte nicht verbunden werden. Du kannst als Gast fortfahren und dich später anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de connecter votre compte Twitch. Vous pouvez continuer en invité et vous connecter plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar tu cuenta de Twitch. Puedes continuar como invitado e iniciar sesión más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile collegare il tuo account Twitch. Puoi continuare come ospite e accedere più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitchアカウントを連携できませんでした。ゲストとして続け、あとからログインすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Twitch 계정을 연결하지 못했습니다. 게스트로 계속한 뒤 나중에 로그인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接你的 Twitch 账号。你可以先以访客身份继续，稍后再登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連結你的 Twitch 帳號。你可以先以訪客身分繼續，稍後再登入。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar sua conta da Twitch. Você pode continuar como convidado e entrar depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć konta Twitcha. Możesz kontynuować jako gość i zalogować się później."
          }
        }
      }
    },
