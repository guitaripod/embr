    "No account needed: tap the star on any channel to keep it in Favorites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto nötig: Tippe bei einem Kanal auf den Stern, um ihn in den Favoriten zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte requis : touchez l'étoile d'une chaîne pour la garder dans Favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta cuenta: toca la estrella de un canal para guardarlo en Favoritos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve un account: tocca la stella su un canale per tenerlo tra i Preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。チャンネルのスターをタップすると、お気に入りに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요하지 않습니다. 채널의 별표를 탭하면 즐겨찾기에 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号：点按任意频道上的星标，即可收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要帳號：點一下任何頻道上的星號，即可加入我的最愛。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é preciso ter conta: toque na estrela de um canal para guardá-lo em Favoritos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nie jest wymagane: stuknij gwiazdkę przy kanale, aby zachować go w Ulubionych."
          }
        }
      }
    },
    "No account? Star channels to keep them in Favorites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto? Markiere Kanäle mit dem Stern, um sie in den Favoriten zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
