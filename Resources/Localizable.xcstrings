    "They can't chat in this channel until someone unbans them.": {
      "comment": "Studio ban confirm",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke chatte i denne kanal, før nogen ophæver deres udelukkelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können in diesem Kanal nicht chatten, bis jemand die Sperre aufhebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrán chatear en este canal hasta que alguien les quite el baneo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "He eivät voi chatata tällä kanavalla, ennen kuin joku poistaa porttikiellon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne pourra pas discuter dans cette chaîne tant que quelqu'un ne la débannira pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Viðkomandi getur ekki spjallað í þessari rás fyrr en einhver aflétti banninu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non possono scrivere in questo canale finché qualcuno non li sbanna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが BAN を解除するまで、このチャンネルではチャットできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 해제될 때까지 이 채널에서 채팅할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke chatte i denne kanalen før noen opphever utestengelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogą pisać na tym kanale, dopóki ktoś ich nie odbanuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pessoa não pode conversar neste canal até que alguém remova o banimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan inte chatta i den här kanalen förrän någon avbannar dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在有人解除封禁之前，他们无法在此频道聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在有人解除封禁之前，他們無法在此頻道聊天。"
          }
        }
      }
    },
