    "Ad break. Tap to play Embr Flyer while the stream resumes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbepause. Tippe, um Embr Flyer zu spielen, bis der Stream weitergeht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause publicitaire. Touchez pour jouer à Embr Flyer en attendant la reprise du stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa publicitaria. Toca para jugar a Embr Flyer mientras vuelve el stream."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa pubblicitaria. Tocca per giocare a Embr Flyer mentre lo stream riprende."
