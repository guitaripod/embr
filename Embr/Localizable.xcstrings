            "value": "Auch mit Twitch Turbo oder einem Kanal-Abo — hier steht, warum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même avec Twitch Turbo ou un abonnement à la chaîne — voici pourquoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso con Twitch Turbo o una suscripción al canal: esto es lo que pasa."
          }
        },
        "it": {
          "stringUnit": {
