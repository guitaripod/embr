    "Reported %@. Their messages are now hidden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gemeldet. Die Nachrichten werden jetzt ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ signalé. Ses messages sont désormais masqués."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has reportado a %@. Sus mensajes ahora están ocultos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segnalato. I suoi messaggi ora sono nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を報告しました。今後メッセージは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 신고했습니다. 이제 해당 사용자의 메시지는 숨겨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已举报 %@。该用户的消息将不再显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢舉 %@。對方的訊息將不再顯示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ denunciado. As mensagens dele agora estão ocultas."
          }
        }
