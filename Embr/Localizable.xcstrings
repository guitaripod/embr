    "Tap the star on any channel, or press and hold a stream, to keep it here. No account needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem beliebigen Kanal auf den Stern oder halte einen Stream gedrückt, um ihn hier zu behalten. Kein Konto nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'étoile sur une chaîne ou restez appuyé sur un stream pour l'ajouter ici. Aucun compte requis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la estrella de cualquier canal o mantén pulsado un stream para guardarlo aquí. No hace falta una cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la stella su un canale qualsiasi oppure tieni premuto uno stream per salvarlo qui. Non serve un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルのスターをタップするか、配信を長押しすると、ここに追加されます。アカウントは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채널의 별표를 탭하거나 방송을 길게 누르면 여기에 추가됩니다. 계정이 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela de qualquer canal ou toque e segure um stream para guardá-lo aqui. Não é preciso ter conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按任意频道上的星标，或长按直播即可收藏到这里。无需账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下任何頻道上的星號，或長按直播即可加入我的最愛。不需要帳號。"
          }
        }
      }
    },
