    "Playback stopped. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe gestoppt. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture interrompue. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha detenido la reproducción. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduzione interrotta. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が停止しました。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 중단되었습니다. 연결 상태를 확인한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
