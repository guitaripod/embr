            "state": "translated",
            "value": "Los mensajes que contengan esta palabra o frase se ocultarán del chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi che contengono questa parola o frase verranno nascosti nella chat."
