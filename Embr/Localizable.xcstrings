    "Messages containing this word or phrase will be hidden from chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit diesem Wort oder dieser Wendung werden im Chat ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages contenant ce mot ou cette expression seront masqués dans le chat."
          }
        },
        "es": {
